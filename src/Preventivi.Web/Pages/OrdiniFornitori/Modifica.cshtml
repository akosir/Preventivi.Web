@page "{id:int?}"
@model global::Preventivi.Web.Pages.OrdiniFornitori.ModificaModel
@{ ViewData["Title"] = Model.Ordine is null ? "Nuovo ordine fornitore" : $"Modifica ordine {Model.Ordine.NumeroCompleto}"; }
<div class="mb-3"><a asp-page="./Index">Ordini fornitori</a><h1 class="h3 mt-2">@ViewData["Title"]</h1></div>
<section class="pfw-panel">
    <div class="pfw-panel-header"><h2 class="pfw-panel-title">Dati ordine</h2></div>
    <form method="post">
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Dati.VersioneRiga" type="hidden" />
            @if (Model.Ordine is not null) { <p>Anno di numerazione @Model.Ordine.Anno</p> }
            <div class="row g-3">
                <div class="col-12 col-md-4 pfw-field-required">
                    <label asp-for="Dati.DataOrdine" class="form-label">Data ordine *</label>
                    <input asp-for="Dati.DataOrdine" class="form-control" />
                    <span asp-validation-for="Dati.DataOrdine" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-8 pfw-field-required">
                    <label asp-for="Dati.IdFornitore" class="form-label">Fornitore *</label>
                    <select asp-for="Dati.IdFornitore" class="form-select">
                        <option value="">Seleziona un fornitore</option>
                        @foreach (var f in Model.Fornitori) { <option value="@f.IdFornitore">@f.Display@(f.Attivo ? "" : " (non attivo)")</option> }
                    </select>
                    <span asp-validation-for="Dati.IdFornitore" class="text-danger"></span>
                </div>
                <div class="col-12"><label asp-for="Dati.Oggetto" class="form-label">Oggetto</label><input asp-for="Dati.Oggetto" class="form-control" /><span asp-validation-for="Dati.Oggetto" class="text-danger"></span></div>
                <div class="col-12 col-md-4"><label asp-for="Dati.DataConsegnaPrevista" class="form-label">Consegna prevista</label><input asp-for="Dati.DataConsegnaPrevista" class="form-control" /></div>
                <div class="col-12"><label asp-for="Dati.Note" class="form-label">Note</label><textarea asp-for="Dati.Note" class="form-control" rows="4"></textarea></div>
            </div>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2">
            @if (Model.Ordine is null) { <a asp-page="./Index" class="pfw-btn pfw-btn-secondary">Annulla</a> }
            else { <a asp-page="./Dettaglio" asp-route-id="@Model.Ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-secondary">Annulla</a> }
            <button type="submit" class="pfw-btn pfw-btn-primary">Salva</button>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
