@page "{id:int}"
@model global::Preventivi.Web.Pages.OrdiniFornitori.DettaglioModel
@using global::Preventivi.Core.Allegati
@{ var ordine = Model.Ordine!; ViewData["Title"] = $"Ordine {ordine.NumeroCompleto}";
   var returnUrl = Url.Page("./Dettaglio", new { id = ordine.IdOrdineFornitore })!; }
<div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
    <div><a asp-page="./Index">Ordini fornitori</a><h1 class="h3 mt-2">Ordine @ordine.NumeroCompleto</h1></div>
    <div class="d-flex gap-2 align-items-start">
        <a asp-page="./Modifica" class="pfw-btn pfw-btn-secondary">Nuovo</a>
        <a asp-page="./Stampa" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-secondary">Stampa ordine</a>
        @if (ordine.Modificabile)
        {
            <a asp-page="./Modifica" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-primary">Modifica</a>
            <a asp-page="./Elimina" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-danger">Elimina</a>
        }
    </div>
</div>
@if (TempData["MessaggioSuccesso"] is string messaggio) { <div class="alert alert-success" role="status">@messaggio</div> }
<section class="pfw-panel mb-3">
    <div class="pfw-panel-header"><h2 class="pfw-panel-title">Dati ordine</h2><span class="pfw-badge pfw-badge-secondary">@ordine.Stato</span></div>
    <div class="pfw-panel-body">
        <dl class="row">
            <dt class="col-sm-4">Fornitore</dt><dd class="col-sm-8">@ordine.CodiceFornitore - @ordine.RagioneSociale</dd>
            <dt class="col-sm-4">Data ordine</dt><dd class="col-sm-8">@ordine.DataOrdine.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-4">Oggetto</dt><dd class="col-sm-8">@(ordine.Oggetto ?? "-")</dd>
            <dt class="col-sm-4">Consegna prevista</dt><dd class="col-sm-8">@(ordine.DataConsegnaPrevista?.ToString("dd/MM/yyyy") ?? "-")</dd>
            <dt class="col-sm-4">Note</dt><dd class="col-sm-8 text-break">@ordine.Note</dd>
            <dt class="col-sm-4">Totale ordine</dt><dd class="col-sm-8 fw-bold">@ordine.TotaleOrdine.ToString("C2")</dd>
            <dt class="col-sm-4">Creato il</dt><dd class="col-sm-8">@ordine.DataCreazione.ToString("dd/MM/yyyy HH:mm") da @ordine.UtenteCreazione</dd>
            <dt class="col-sm-4">Ultima modifica</dt><dd class="col-sm-8">@(ordine.DataModifica.HasValue ? $"{ordine.DataModifica:dd/MM/yyyy HH:mm} da {ordine.UtenteModifica}" : "-")</dd>
        </dl>
    </div>
</section>
<section class="pfw-panel mb-3">
    <div class="pfw-panel-header">
        <h2 class="pfw-panel-title">Righe ordine</h2>
        @if (ordine.Modificabile) { <a asp-page="./Riga" asp-route-idOrdine="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-primary">Nuova riga</a> }
    </div>
    @if (Model.Righe.Count == 0) { <div class="pfw-panel-body">Nessuna riga presente.</div> }
    else
    {
        <div class="table-responsive"><table class="table pfw-table align-middle">
            <thead><tr><th>Riga</th><th>Tipo</th><th>Descrizione</th><th>UM</th><th class="text-end">Quantità</th><th class="text-end">Prezzo unitario</th><th class="text-end">Totale</th><th>Consegna</th>@if (ordine.Modificabile) { <th>Azioni</th> }</tr></thead>
            <tbody>
            @foreach (var riga in Model.Righe)
            {
                <tr>
                    <td>@riga.RigaNr</td><td>@riga.TipoRiga</td><td>@riga.Descrizione</td><td>@riga.UM</td>
                    <td class="text-end">@riga.Quantita.ToString("N4")</td><td class="text-end">@riga.PrezzoUnitario.ToString("C4")</td><td class="text-end">@riga.TotaleRiga.ToString("C2")</td>
                    <td>@riga.DataConsegnaPrevista?.ToString("dd/MM/yyyy")</td>
                    @if (ordine.Modificabile)
                    {
                        <td><div class="d-flex gap-2">
                            <a asp-page="./Riga" asp-route-idOrdine="@ordine.IdOrdineFornitore" asp-route-id="@riga.IdRigaOrdineFornitore" class="pfw-btn pfw-btn-secondary">Modifica</a>
                            <a asp-page="./Riga" asp-route-idOrdine="@ordine.IdOrdineFornitore" asp-route-id="@riga.IdRigaOrdineFornitore" asp-route-elimina="true" class="pfw-btn pfw-btn-danger">Elimina</a>
                        </div></td>
                    }
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>
<section class="pfw-panel">
    <div class="pfw-panel-header"><h2 class="pfw-panel-title">Allegati ordine</h2></div>
    <div class="pfw-panel-body">
        @await Html.PartialAsync("~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
            new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
            {
                TestoNuovo = "Nuovo allegato", MostraNuovo = true, MostraAggiorna = false,
                UrlNuovo = $"/Allegati/Nuovo?Entita={AllegatoEntita.OrdiniFornitori}&IdEntita={ordine.IdOrdineFornitore}&ReturnUrl={Uri.EscapeDataString(returnUrl)}"
            })
        @if (Model.Allegati.Allegati.Count == 0) { <p class="mt-3">Nessun allegato registrato.</p> }
        else { <partial name="Shared/Allegati/_AllegatiGrid" model="Model.Allegati" /> }
    </div>
</section>
