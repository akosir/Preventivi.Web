@page
@model global::Preventivi.Web.Pages.OrdiniFornitori.IndexModel
@using global::Preventivi.Core.OrdiniFornitori
@{ ViewData["Title"] = "Ordini fornitori"; }
<div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
    <h1 class="h3">Ordini fornitori</h1>
    <a asp-page="./Modifica" class="pfw-btn pfw-btn-primary">Nuovo ordine</a>
</div>
@if (TempData["MessaggioSuccesso"] is string messaggio)
{
    <div class="alert alert-success" role="status">@messaggio</div>
}
<section class="pfw-panel mb-3">
    <div class="pfw-panel-body">
        <form method="get" class="row g-3 align-items-end">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="col-6 col-md-2"><label asp-for="Filtro.Numero" class="form-label">Numero ordine</label><input asp-for="Filtro.Numero" class="form-control" /></div>
            <div class="col-6 col-md-2"><label asp-for="Filtro.Anno" class="form-label">Anno</label><input asp-for="Filtro.Anno" class="form-control" /></div>
            <div class="col-12 col-md-4">
                <label asp-for="Filtro.IdFornitore" class="form-label">Fornitore</label>
                <select asp-for="Filtro.IdFornitore" class="form-select">
                    <option value="">Tutti i fornitori</option>
                    @foreach (var f in Model.Fornitori)
                    {
                        <option value="@f.IdFornitore">@f.CodiceFornitore - @f.RagioneSociale@(f.Attivo ? "" : " (non attivo)")</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Filtro.Stato" class="form-label">Stato</label>
                <select asp-for="Filtro.Stato" class="form-select">
                    <option value="">Tutti gli stati</option>
                    @foreach (var stato in OrdineFornitoreStati.Tutti) { <option value="@stato">@stato</option> }
                </select>
            </div>
            <div class="col-6 col-md-3"><label asp-for="Filtro.Dal" class="form-label">Data ordine dal</label><input asp-for="Filtro.Dal" type="date" class="form-control" /></div>
            <div class="col-6 col-md-3"><label asp-for="Filtro.Al" class="form-label">Data ordine al</label><input asp-for="Filtro.Al" type="date" class="form-control" /></div>
            <div class="col-12 col-md-4"><label asp-for="Filtro.Oggetto" class="form-label">Oggetto</label><input asp-for="Filtro.Oggetto" maxlength="250" class="form-control" /></div>
            <div class="col-12 col-md-2 d-flex gap-2"><button type="submit" class="pfw-btn pfw-btn-primary">Cerca</button><a asp-page="./Index" class="pfw-btn pfw-btn-secondary">Azzera</a></div>
        </form>
    </div>
</section>
<section class="pfw-panel">
    @if (Model.Ordini.Count == 0)
    {
        <div class="pfw-panel-body">Nessun ordine corrisponde ai filtri selezionati.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table pfw-table align-middle">
                <thead><tr><th>Ordine</th><th>Data</th><th>Fornitore</th><th>Oggetto</th><th>Stato</th><th class="text-end">Totale</th><th>Azioni</th></tr></thead>
                <tbody>
                @foreach (var ordine in Model.Ordini)
                {
                    <tr>
                        <td>@ordine.NumeroCompleto</td><td>@ordine.DataOrdine.ToString("dd/MM/yyyy")</td><td>@ordine.RagioneSociale</td>
                        <td>@ordine.Oggetto</td><td><span class="pfw-badge pfw-badge-secondary">@ordine.Stato</span></td><td class="text-end">@ordine.TotaleOrdine.ToString("C2")</td>
                        <td><div class="d-flex gap-2">
                            <a asp-page="./Dettaglio" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-secondary">Apri</a>
                            @if (ordine.Modificabile)
                            {
                                <a asp-page="./Modifica" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-secondary">Modifica</a>
                                <a asp-page="./Elimina" asp-route-id="@ordine.IdOrdineFornitore" class="pfw-btn pfw-btn-danger">Elimina</a>
                            }
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
