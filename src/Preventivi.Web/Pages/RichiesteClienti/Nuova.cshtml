@page
@model global::Preventivi.Web.Pages.RichiesteClienti.NuovaModel

@{
    ViewData["Title"] = "Nuova richiesta cliente";
    ViewData["Clienti"] = Model.Clienti;
    ViewData["ClienteBloccato"] = false;
    ViewData["StatoBloccato"] = false;
}

<div class="workspace-page">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="./Index">Richieste clienti</a>
            <span>/</span>
            <span>Nuova</span>
        </div>
        <h1 class="workspace-title">Nuova richiesta cliente</h1>
    </div>

    <section class="pfw-panel">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dati richiesta</h2>
                <div class="pfw-panel-subtitle">Il numero progressivo viene assegnato al salvataggio</div>
            </div>
        </div>
        <form method="post" class="p-3">
            <partial name="Shared/RichiesteClienti/_RichiestaClienteForm" for="Dati" view-data="ViewData" />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a asp-page="./Index" class="pfw-btn pfw-btn-secondary">Annulla</a>
                <button type="submit" class="pfw-btn pfw-btn-primary">Salva</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
