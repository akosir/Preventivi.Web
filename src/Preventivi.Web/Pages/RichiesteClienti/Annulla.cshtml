@page
@model global::Preventivi.Web.Pages.RichiesteClienti.AnnullaModel

@{
    var richiesta = Model.Richiesta!;
    ViewData["Title"] = $"Annulla richiesta {richiesta.NumeroCompleto}";
}

<div class="workspace-page">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="./Index">Richieste clienti</a>
            <span>/</span>
            <a asp-page="./Dettaglio" asp-route-id="@richiesta.IdRichiestaCliente">@richiesta.NumeroCompleto</a>
            <span>/</span>
            <span>Annulla</span>
        </div>
        <h1 class="workspace-title">Annulla richiesta @richiesta.NumeroCompleto</h1>
    </div>

    <section class="pfw-panel">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Conferma annullamento</h2>
                <div class="pfw-panel-subtitle">La richiesta e i documenti collegati saranno conservati</div>
            </div>
        </div>
        <form method="post" class="p-3">
            <input asp-for="Id" type="hidden" />
            <input asp-for="VersioneRigaBase64" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <p>
                Confermi l'annullamento della richiesta
                <strong>@richiesta.NumeroCompleto - @richiesta.Oggetto</strong>?
            </p>
            <p class="text-muted mb-0">
                L'operazione imposta lo stato su Annullata. Preventivi, campionature, allegati e dati storici non vengono eliminati.
            </p>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a asp-page="./Dettaglio" asp-route-id="@richiesta.IdRichiestaCliente"
                   class="pfw-btn pfw-btn-secondary">Indietro</a>
                <button type="submit" class="pfw-btn pfw-btn-danger">Conferma annullamento</button>
            </div>
        </form>
    </section>
</div>
