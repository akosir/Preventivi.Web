@page
@model global::Preventivi.Web.Pages.Anagrafiche.ModelliCiclo.Righe.ModificaModel
@{ var ciclo=Model.ModelloCiclo!; ViewData["Title"]="Modifica riga modello ciclo"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo">@ciclo.CodiceModelloCiclo</a></div><h1 class="h3 mb-1">Modifica riga modello ciclo</h1></div><a asp-page="./Elimina" asp-route-idModelloCiclo="@ciclo.IdModelloCiclo" asp-route-id="@Model.IdRiga" class="pfw-btn pfw-btn-danger">Elimina</a></div>
<section class="pfw-panel"><div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Dati lavorazione</h2><div class="pfw-panel-subtitle">Tempi e costi sono copie autonome del modello ciclo</div></div></div><form method="post"><input type="hidden" name="idModelloCiclo" value="@ciclo.IdModelloCiclo" /><input type="hidden" name="id" value="@Model.IdRiga" /><div class="pfw-panel-body">@await Html.PartialAsync("~/Pages/Shared/Anagrafiche/_ModelloCicloRigaForm.cshtml", Model.Dati, ViewData)</div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form></section>
