@page
@model global::Preventivi.Web.Pages.Anagrafiche.ModelliCiclo.Righe.EliminaModel
@{var ciclo=Model.ModelloCiclo!;var riga=Model.Riga!;ViewData["Title"]="Elimina riga modello ciclo";}
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo">@ciclo.CodiceModelloCiclo</a></div><h1 class="h3 mb-1">Elimina riga modello ciclo</h1></div>
<section class="pfw-panel"><div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Conferma eliminazione</h2><div class="pfw-panel-subtitle">La cancellazione riguarda soltanto questa copia nel modello</div></div></div><div class="pfw-panel-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><p>Confermi l'eliminazione della riga <strong>@riga.RigaNr</strong>, lavorazione <strong>@riga.CodiceLavorazione - @riga.DescrizioneLavorazione</strong>?</p></div><form method="post"><input type="hidden" name="idModelloCiclo" value="@ciclo.IdModelloCiclo"/><input type="hidden" name="id" value="@riga.IdRigaModelloCiclo"/><input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(riga.VersioneRiga)"/><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button></div></form></section>
