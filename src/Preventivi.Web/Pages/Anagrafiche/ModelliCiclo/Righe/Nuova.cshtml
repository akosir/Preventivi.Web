@page
@model global::Preventivi.Web.Pages.Anagrafiche.ModelliCiclo.Righe.NuovaModel
@{ var ciclo=Model.ModelloCiclo!; ViewData["Title"]="Nuova riga modello ciclo"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo">@ciclo.CodiceModelloCiclo</a></div><h1 class="h3 mb-1">Nuova riga modello ciclo</h1></div>
<section class="pfw-panel"><div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Dati lavorazione</h2><div class="pfw-panel-subtitle">I valori proposti vengono copiati e restano modificabili</div></div></div><form method="post"><input type="hidden" name="idModelloCiclo" value="@ciclo.IdModelloCiclo" /><div class="pfw-panel-body">@await Html.PartialAsync("~/Pages/Shared/Anagrafiche/_ModelloCicloRigaForm.cshtml", Model.Dati, ViewData)</div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Dettaglio" asp-route-id="@ciclo.IdModelloCiclo" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form></section>
