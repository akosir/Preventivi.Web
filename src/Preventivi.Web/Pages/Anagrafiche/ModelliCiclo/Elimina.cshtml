@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.ModelliCiclo.EliminaModel
@{ var ciclo=Model.ModelloCiclo!; ViewData["Title"]="Elimina modello ciclo"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="./Dettaglio" asp-route-id="@ciclo.IdModelloCiclo">Modello ciclo</a></div><h1 class="h3 mb-1">Elimina modello ciclo</h1></div>
<section class="pfw-panel"><div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Conferma eliminazione</h2><div class="pfw-panel-subtitle">L'operazione e definitiva e non elimina contenuti collegati</div></div></div><div class="pfw-panel-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><p>Confermi l'eliminazione di <strong>@ciclo.CodiceModelloCiclo - @ciclo.Descrizione</strong>?</p><p class="pfw-secondary-text mb-0">Se il modello contiene righe, allegati o riferimenti, dovra essere disattivato.</p></div><form method="post"><input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(ciclo.VersioneRiga)" /><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="./Dettaglio" asp-route-id="@ciclo.IdModelloCiclo" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button></div></form></section>
