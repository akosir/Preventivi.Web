@page
@model global::Preventivi.Web.Pages.Anagrafiche.ModelliCiclo.IndexModel
@{ ViewData["Title"] = "Modelli ciclo"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div><div class="pfw-secondary-text mb-1"><a asp-page="../Index">Anagrafiche</a></div><h1 class="h3 mb-1">Modelli ciclo</h1><p class="pfw-secondary-text mb-0">Sequenze standard di lavorazione, tempi e costi</p></div>
    <a asp-page="./Nuovo" class="pfw-btn pfw-btn-primary">Nuovo</a>
</div>
@if (TempData["MessaggioSuccesso"] is string messaggio) { <div class="alert alert-success" role="alert">@messaggio</div> }
<section class="pfw-panel mb-3"><div class="pfw-panel-body"><form method="get" class="row g-3 align-items-end">
    <div class="col-12 col-md-7"><label asp-for="Ricerca" class="form-label">Codice o descrizione</label><input asp-for="Ricerca" class="form-control" /></div>
    <div class="col-12 col-md-3"><label asp-for="Stato" class="form-label">Stato</label><select asp-for="Stato" class="form-select"><option value="attivi">Attivi</option><option value="nonattivi">Non attivi</option><option value="tutti">Tutti</option></select></div>
    <div class="col-12 col-md-2 d-flex gap-2"><button type="submit" class="pfw-btn pfw-btn-primary flex-grow-1">Cerca</button><a asp-page="./Index" class="pfw-btn pfw-btn-secondary">Azzera</a></div>
</form></div></section>
<section class="pfw-panel">
@if (Model.Modelli.Count == 0) { <div class="pfw-panel-body">@await Html.PartialAsync("Shared/PFW/EmptyState/_PFWEmptyState", new global::Preventivi.Web.UI.EmptyState.PFWEmptyStateModel { Titolo = "Nessun modello ciclo", Messaggio = "Non sono presenti modelli ciclo corrispondenti ai filtri selezionati." })</div> }
else { <div class="table-responsive"><table class="table pfw-table align-middle mb-0"><thead><tr><th>Codice</th><th>Descrizione</th><th>Righe</th><th>Stato</th><th class="text-end">Azioni</th></tr></thead><tbody>
@foreach (var item in Model.Modelli) { <tr><td class="fw-semibold">@item.CodiceModelloCiclo</td><td>@item.Descrizione</td><td>@item.NumeroRighe</td><td><span class="pfw-badge @(item.Attivo ? "pfw-badge-success" : "pfw-badge-secondary")">@(item.Attivo ? "Attivo" : "Non attivo")</span></td><td class="text-end"><a asp-page="./Dettaglio" asp-route-id="@item.IdModelloCiclo" class="pfw-btn pfw-btn-secondary">Apri</a></td></tr> }
</tbody></table></div> }
</section>
