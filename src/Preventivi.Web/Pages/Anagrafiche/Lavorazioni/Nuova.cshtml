@page
@model global::Preventivi.Web.Pages.Anagrafiche.Lavorazioni.NuovaModel
@{ ViewData["Title"] = "Nuova lavorazione"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="./Index">Lavorazioni</a></div><h1 class="h3 mb-0">Nuova lavorazione</h1></div>
<section class="pfw-panel">
    <div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Dati lavorazione</h2><div class="pfw-panel-subtitle">I campi contrassegnati sono obbligatori</div></div></div>
    <form method="post"><div class="pfw-panel-body"><partial name="Shared/Anagrafiche/_LavorazioneForm" model="Model.Dati" view-data="Model.ViewData" /></div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="./Index" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
