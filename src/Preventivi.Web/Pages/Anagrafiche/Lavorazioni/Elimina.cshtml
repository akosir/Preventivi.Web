@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Lavorazioni.EliminaModel
@{ var lavorazione = Model.Lavorazione!; ViewData["Title"] = "Elimina lavorazione"; }

<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="./Dettaglio" asp-route-id="@lavorazione.IdLavorazione">Dettaglio lavorazione</a></div><h1 class="h3 mb-0">Elimina lavorazione</h1></div>
<section class="pfw-panel">
    <div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Conferma eliminazione</h2><div class="pfw-panel-subtitle">L'operazione e consentita soltanto per lavorazioni mai utilizzate</div></div></div>
    <form method="post">
        <input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(lavorazione.VersioneRiga)" />
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <p>Confermi l'eliminazione di <strong>@lavorazione.CodiceLavorazione - @lavorazione.Descrizione</strong>?</p>
            <p class="pfw-secondary-text mb-0">Le lavorazioni gia utilizzate devono essere disattivate.</p>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="./Dettaglio" asp-route-id="@lavorazione.IdLavorazione" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button></div>
    </form>
</section>
