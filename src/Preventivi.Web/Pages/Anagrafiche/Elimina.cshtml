@page "{tipo}/{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.EliminaModel

@{
    ViewData["Title"] = $"Elimina {Model.Pagina?.TitoloSingolare}";
}

<div class="mb-3">
    <div class="pfw-secondary-text mb-1"><a asp-page="./Dettaglio" asp-route-tipo="@Model.Pagina!.Chiave" asp-route-id="@Model.Dettaglio!.Id">Dettaglio</a></div>
    <h1 class="h3 mb-0">Elimina @Model.Pagina.TitoloSingolare</h1>
</div>

<section class="pfw-panel">
    <div class="pfw-panel-header">
        <div>
            <h2 class="pfw-panel-title">Conferma eliminazione</h2>
            <div class="pfw-panel-subtitle">L'operazione e consentita soltanto se l'elemento non e mai stato utilizzato</div>
        </div>
    </div>
    <form method="post">
        <input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(Model.Dettaglio!.VersioneRiga)" />
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <p>Confermi l'eliminazione di <strong>@Model.Dettaglio.Descrizione</strong>?</p>
            <p class="pfw-secondary-text mb-0">Se l'elemento e gia referenziato, il database impedira l'eliminazione. In quel caso dovra essere disattivato dal dettaglio.</p>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2">
            <a asp-page="./Dettaglio" asp-route-tipo="@Model.Pagina.Chiave" asp-route-id="@Model.Dettaglio.Id" class="pfw-btn pfw-btn-secondary">Annulla</a>
            <button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button>
        </div>
    </form>
</section>
