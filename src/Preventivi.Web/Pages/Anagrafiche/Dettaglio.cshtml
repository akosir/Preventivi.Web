@page "{tipo}/{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.DettaglioModel

@{
    var pagina = Model.Pagina!;
    var dettaglio = Model.Dettaglio!;
    ViewData["Title"] = $"Dettaglio {pagina.TitoloSingolare}";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="pfw-secondary-text mb-1"><a asp-page="./Gestione" asp-route-tipo="@pagina.Chiave">@pagina.Titolo</a></div>
        <h1 class="h3 mb-0">Dettaglio @pagina.TitoloSingolare</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="./Modifica" asp-route-tipo="@pagina.Chiave" asp-route-id="@dettaglio.Id" class="pfw-btn pfw-btn-primary">Modifica</a>
        <a asp-page="./Elimina" asp-route-tipo="@pagina.Chiave" asp-route-id="@dettaglio.Id" class="pfw-btn pfw-btn-danger">Elimina</a>
    </div>
</div>

@if (TempData["MessaggioSuccesso"] is string messaggio)
{
    <div class="alert alert-success" role="alert">@messaggio</div>
}

<section class="pfw-panel">
    <div class="pfw-panel-header">
        <div>
            <h2 class="pfw-panel-title">Dati anagrafici</h2>
            <div class="pfw-panel-subtitle">Informazioni correnti e stato di utilizzo</div>
        </div>
    </div>
    <div class="pfw-panel-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <dl class="row mb-0">
            @if (pagina.MostraCodice)
            {
                <dt class="col-sm-3">Codice</dt>
                <dd class="col-sm-9">@dettaglio.Codice</dd>
            }
            <dt class="col-sm-3">Descrizione</dt>
            <dd class="col-sm-9">@dettaglio.Descrizione</dd>
            <dt class="col-sm-3">Stato</dt>
            <dd class="col-sm-9">
                <span class="pfw-badge @(dettaglio.Attivo ? "pfw-badge-success" : "pfw-badge-secondary")">
                    @(dettaglio.Attivo ? "Attivo" : "Non attivo")
                </span>
            </dd>
            <dt class="col-sm-3">Creato il</dt>
            <dd class="col-sm-9">@dettaglio.DataCreazione.ToString("dd/MM/yyyy HH:mm") da @dettaglio.UtenteCreazione</dd>
            <dt class="col-sm-3">Ultima modifica</dt>
            <dd class="col-sm-9">
                @(dettaglio.DataModifica.HasValue
                    ? $"{dettaglio.DataModifica:dd/MM/yyyy HH:mm} da {dettaglio.UtenteModifica}"
                    : "-")
            </dd>
        </dl>
    </div>
    <div class="pfw-panel-footer d-flex justify-content-between gap-2">
        <a asp-page="./Gestione" asp-route-tipo="@pagina.Chiave" class="pfw-btn pfw-btn-secondary">Torna all'elenco</a>
        <form method="post" asp-page-handler="@(dettaglio.Attivo ? "Disattiva" : "Attiva")">
            <input type="hidden" name="id" value="@dettaglio.Id" />
            <input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(dettaglio.VersioneRiga)" />
            <button type="submit" class="pfw-btn pfw-btn-secondary">
                @(dettaglio.Attivo ? "Disattiva" : "Riattiva")
            </button>
        </form>
    </div>
</section>
