@page
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Lavorazioni.NuovoModel
@{ var nodo = Model.Nodo!; ViewData["Title"] = "Nuova lavorazione distinta"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta">@nodo.DescrizioneNodo</a></div><h1 class="h3 mb-0">Nuova lavorazione distinta</h1></div>
<section class="pfw-panel"><form method="post"><div class="pfw-panel-body"><partial name="Shared/Anagrafiche/_DistintaLavorazioneForm" model="Model.Dati" view-data="Model.ViewData" /></div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('lavorazione-select')?.addEventListener('change', function () { const o = this.options[this.selectedIndex]; const set = (id, value) => { const e = document.getElementById(id); if (e && value) e.value = value.replace('.', ','); }; set('lavorazione-costo', o?.dataset.costo); set('lavorazione-setup', o?.dataset.setup); set('lavorazione-pezzo', o?.dataset.pezzo); });</script> }
