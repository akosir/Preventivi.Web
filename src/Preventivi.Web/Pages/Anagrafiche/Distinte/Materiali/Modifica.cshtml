@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Materiali.ModificaModel
@using global::Preventivi.Core.Allegati
@{ var materiale = Model.Materiale!; var nodo = Model.Nodo!; var returnUrl = Url.Page("/Anagrafiche/Distinte/Materiali/Modifica", new { id = materiale.IdDistintaMateriale })!; ViewData["Title"] = "Modifica materiale distinta"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta">@nodo.DescrizioneNodo</a></div><h1 class="h3 mb-0">Modifica materiale distinta</h1></div>
@if (TempData["MessaggioSuccesso"] is string messaggio) { <div class="alert alert-success" role="alert">@messaggio</div> }
<section class="pfw-panel mb-3"><form method="post"><div class="pfw-panel-body"><partial name="Shared/Anagrafiche/_DistintaMaterialeForm" model="Model.Dati" view-data="Model.ViewData" /></div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Torna al nodo</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form></section>
<section class="pfw-panel"><div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Allegati materiale distinta</h2><div class="pfw-panel-subtitle">Documenti specifici dell'associazione al nodo</div></div></div><div class="pfw-panel-body">@await Html.PartialAsync("~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml", new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel { TestoNuovo = "Nuovo allegato", UrlNuovo = $"/Allegati/Nuovo?Entita={AllegatoEntita.DistintaMateriali}&IdEntita={materiale.IdDistintaMateriale}&ReturnUrl={Uri.EscapeDataString(returnUrl)}", MostraNuovo = true, MostraAggiorna = false }) @if (Model.Allegati.Allegati.Count == 0) { <div class="pfw-secondary-text mt-3">Nessun allegato registrato.</div> } else { @await Html.PartialAsync("~/Pages/Shared/Allegati/_AllegatiGrid.cshtml", Model.Allegati) }</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('materiale-select')?.addEventListener('change', function () { const option = this.options[this.selectedIndex]; const costo = document.getElementById('materiale-costo'); if (costo && option?.dataset.costo) costo.value = option.dataset.costo.replace('.', ','); });</script> }
