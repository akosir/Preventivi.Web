@page
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Materiali.NuovoModel
@{ var nodo = Model.Nodo!; ViewData["Title"] = "Nuovo materiale distinta"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta">@nodo.DescrizioneNodo</a></div><h1 class="h3 mb-0">Nuovo materiale distinta</h1></div>
<section class="pfw-panel"><form method="post"><div class="pfw-panel-body"><partial name="Shared/Anagrafiche/_DistintaMaterialeForm" model="Model.Dati" view-data="Model.ViewData" /></div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="../Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('materiale-select')?.addEventListener('change', function () { const option = this.options[this.selectedIndex]; const costo = document.getElementById('materiale-costo'); if (costo && option?.dataset.costo) costo.value = option.dataset.costo.replace('.', ','); });</script> }
