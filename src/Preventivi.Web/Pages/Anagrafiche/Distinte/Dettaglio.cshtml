@page
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.DettaglioModel
@{ var articolo = Model.Articolo!; ViewData["Title"] = "Dettaglio distinta base"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="pfw-secondary-text mb-1"><a asp-page="./Index">Distinte base</a></div>
        <h1 class="h3 mb-1">@articolo.CodiceArticolo - @articolo.Descrizione</h1>
        <p class="pfw-secondary-text mb-0">Struttura produttiva dell'articolo</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Stampa" asp-route-idArticolo="@articolo.IdArticolo" class="pfw-btn pfw-btn-primary">Scarica PDF</a>
        <a asp-page="../Articoli/Dettaglio" asp-route-id="@articolo.IdArticolo" class="pfw-btn pfw-btn-secondary">Articolo</a>
        @if (!Model.Nodi.Any(n => n.IdNodoPadre is null && n.Attivo))
        {
            <a asp-page="./Nodi/Nuovo" asp-route-idArticolo="@articolo.IdArticolo" class="pfw-btn pfw-btn-primary">Nuovo nodo radice</a>
        }
    </div>
</div>

@if (TempData["MessaggioSuccesso"] is string messaggio)
{
    <div class="alert alert-success" role="alert">@messaggio</div>
}

<section class="pfw-panel">
    <div class="pfw-panel-header">
        <div>
            <h2 class="pfw-panel-title">Albero distinta</h2>
            <div class="pfw-panel-subtitle">La struttura mostra i rapporti padre-figlio e i livelli calcolati dal sistema</div>
        </div>
    </div>
    @if (Model.Nodi.Count == 0)
    {
        <div class="pfw-panel-body"><div class="pfw-secondary-text">Nessun nodo presente. Creare il nodo radice per iniziare la distinta.</div></div>
    }
    else
    {
        <div class="pfw-tree-grid">
            <div class="pfw-tree-grid-header" aria-hidden="true">
                <div>Struttura distinta</div>
                <div>Tipo nodo</div>
                <div>Quantità base</div>
                <div>Ordine</div>
                <div>Stato</div>
                <div class="text-end">Azioni</div>
            </div>
            <div class="pfw-tree-grid-body" role="tree" aria-label="Struttura gerarchica della distinta base">
                @foreach (var nodo in Model.Nodi)
                {
                    <div class="pfw-tree-grid-row @(!nodo.Attivo ? "is-inactive" : string.Empty)"
                         role="treeitem"
                         aria-level="@(nodo.Livello + 1)">
                        <div class="pfw-tree-grid-structure">
                            <span class="pfw-tree-guides" aria-hidden="true">
                                @for (var livello = 0; livello < nodo.Livello; livello++)
                                {
                                    <span class="pfw-tree-guide @(livello == nodo.Livello - 1 ? "is-branch" : string.Empty)"></span>
                                }
                            </span>
                            <span class="pfw-tree-node-marker @(nodo.IdNodoPadre is null ? "is-root" : string.Empty)" aria-hidden="true"></span>
                            <span class="pfw-tree-node-content">
                                <span class="pfw-tree-node-title">
                                    @if (!string.IsNullOrWhiteSpace(nodo.CodiceNodo))
                                    {
                                        <strong>@nodo.CodiceNodo</strong>
                                        <span aria-hidden="true">—</span>
                                    }
                                    <span>@nodo.DescrizioneNodo</span>
                                </span>
                                <span class="pfw-tree-level">Livello @(nodo.Livello)</span>
                            </span>
                        </div>
                        <div class="pfw-tree-grid-cell">
                            <span class="pfw-tree-grid-label">Tipo nodo</span>
                            <span>@nodo.TipoNodo</span>
                        </div>
                        <div class="pfw-tree-grid-cell">
                            <span class="pfw-tree-grid-label">Quantità base</span>
                            <span>@nodo.QuantitaBase.ToString("N4")</span>
                        </div>
                        <div class="pfw-tree-grid-cell">
                            <span class="pfw-tree-grid-label">Ordine</span>
                            <span>@nodo.OrdineVisualizzazione</span>
                        </div>
                        <div class="pfw-tree-grid-cell">
                            <span class="pfw-tree-grid-label">Stato</span>
                            <span class="pfw-badge @(nodo.Attivo ? "pfw-badge-success" : "pfw-badge-secondary")">@(nodo.Attivo ? "Attivo" : "Non attivo")</span>
                        </div>
                        <div class="pfw-tree-grid-actions">
                            <a asp-page="./Nodi/Dettaglio" asp-route-id="@nodo.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Apri</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</section>
