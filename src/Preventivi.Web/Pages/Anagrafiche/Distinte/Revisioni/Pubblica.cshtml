@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Revisioni.PubblicaModel
@{ var revisione = Model.Revisione!; ViewData["Title"] = "Pubblica revisione distinta"; }

<div class="mb-3">
    <div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-idArticolo="@revisione.IdArticolo" asp-route-idRevisione="@revisione.IdRevisioneDistinta">@revisione.CodiceArticolo - Rev. @revisione.NumeroRevisione</a></div>
    <h1 class="h3 mb-1">Pubblica revisione distinta</h1>
    <p class="pfw-secondary-text mb-0">Dopo la pubblicazione la revisione sara immutabile e l'eventuale precedente diventera superata.</p>
</div>

<section class="pfw-panel">
    <form method="post">
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="Dati.VersioneRigaBase64" type="hidden" />
            <div>
                <label asp-for="Dati.Motivazione" class="form-label">Motivazione amministrativa *</label>
                <textarea asp-for="Dati.Motivazione" class="form-control pfw-required" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="Dati.Motivazione" class="text-danger"></span>
            </div>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2">
            <a asp-page="../Dettaglio" asp-route-idArticolo="@revisione.IdArticolo" asp-route-idRevisione="@revisione.IdRevisioneDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a>
            <button type="submit" class="pfw-btn pfw-btn-primary">Pubblica revisione</button>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
