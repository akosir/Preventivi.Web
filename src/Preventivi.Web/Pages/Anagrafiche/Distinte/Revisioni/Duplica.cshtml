@page
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Revisioni.DuplicaModel
@{ var sorgente = Model.Sorgente!; ViewData["Title"] = "Duplica distinta"; }

<div class="mb-3">
    <div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-idArticolo="@sorgente.IdArticolo">@sorgente.CodiceArticolo</a></div>
    <h1 class="h3 mb-1">Duplica distinta su un altro articolo</h1>
    <p class="pfw-secondary-text mb-0">Scegli un articolo senza distinta corrente. La copia comprende struttura, materiali, lavorazioni e allegati indipendenti.</p>
</div>

<section class="pfw-panel">
    <form method="post">
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Dati.IdArticoloDestinazione" class="form-label">Articolo di destinazione *</label>
                    <select asp-for="Dati.IdArticoloDestinazione" class="form-select pfw-required">
                        <option value="">Seleziona l'articolo</option>
                        @foreach (var articolo in Model.Articoli)
                        {
                            <option value="@articolo.IdArticolo">@articolo.CodiceArticolo - @articolo.Descrizione</option>
                        }
                    </select>
                    <span asp-validation-for="Dati.IdArticoloDestinazione" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Dati.Note" class="form-label">Note della distinta</label>
                    <textarea asp-for="Dati.Note" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="Dati.Note" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2">
            <a asp-page="../Dettaglio" asp-route-idArticolo="@sorgente.IdArticolo" asp-route-idRevisione="@sorgente.IdRevisioneDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a>
            <button type="submit" class="pfw-btn pfw-btn-primary">Duplica distinta</button>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
