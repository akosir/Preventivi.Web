@page
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Revisioni.NuovaModel
@{ var articolo = Model.Articolo!; ViewData["Title"] = Model.Sorgente is null ? "Crea distinta" : "Nuova revisione distinta"; }

<div class="mb-3">
    <div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-idArticolo="@articolo.IdArticolo">@articolo.CodiceArticolo - Distinta base</a></div>
    <h1 class="h3 mb-1">@(Model.Sorgente is null ? "Crea distinta base" : $"Nuova revisione da Rev. {Model.Sorgente.NumeroRevisione}")</h1>
    <p class="pfw-secondary-text mb-0">La distinta è modificabile appena creata.</p>
</div>

<section class="pfw-panel">
    <form method="post">
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><strong>Articolo:</strong> @articolo.CodiceArticolo - @articolo.Descrizione</div>
            <div>
                <label asp-for="Dati.Note" class="form-label">Note della distinta</label>
                <textarea asp-for="Dati.Note" class="form-control" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="Dati.Note" class="text-danger"></span>
            </div>
        </div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2">
            <a asp-page="../Dettaglio" asp-route-idArticolo="@articolo.IdArticolo" asp-route-idRevisione="@Model.Sorgente?.IdRevisioneDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a>
            <button type="submit" class="pfw-btn pfw-btn-primary">Crea distinta</button>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
