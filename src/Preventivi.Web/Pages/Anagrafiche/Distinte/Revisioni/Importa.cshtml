@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Revisioni.ImportaModel
@{ var revisione = Model.Revisione!; ViewData["Title"] = "Importa distinta da Excel"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="pfw-secondary-text mb-1"><a asp-page="../Dettaglio" asp-route-idArticolo="@revisione.IdArticolo" asp-route-idRevisione="@revisione.IdRevisioneDistinta">@revisione.CodiceArticolo - Rev. @revisione.NumeroRevisione</a></div>
        <h1 class="h3 mb-1">Importa distinta da Excel</h1>
        <p class="pfw-secondary-text mb-0">L'importazione è applicata soltanto dopo anteprima e conferma.</p>
    </div>
    <a asp-page-handler="Modello" asp-route-id="@revisione.IdRevisioneDistinta" class="pfw-btn pfw-btn-secondary">Scarica modello Excel</a>
</div>

<section class="pfw-panel mb-3">
    <div class="pfw-panel-header"><div><h2 class="pfw-panel-title">File da controllare</h2><div class="pfw-panel-subtitle">Formato ammesso: .xlsx, massimo 2 MB</div></div></div>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Anteprima">
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (!Model.BozzaVuota)
            {
                <div class="alert alert-warning mb-0">La distinta contiene già dei nodi. L'importazione è disponibile per le distinte vuote.</div>
            }
            else
            {
                <label asp-for="Dati.File" class="form-label">File Excel *</label>
                <input asp-for="Dati.File" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="form-control pfw-required" />
                <span asp-validation-for="Dati.File" class="text-danger"></span>
            }
        </div>
        @if (Model.BozzaVuota)
        {
            <div class="pfw-panel-footer d-flex justify-content-end gap-2"><button type="submit" class="pfw-btn pfw-btn-primary">Genera anteprima</button></div>
        }
    </form>
</section>

@if (Model.Analisi is not null)
{
    <section class="pfw-panel mb-3">
        <div class="pfw-panel-header"><div><h2 class="pfw-panel-title">Esito validazione</h2><div class="pfw-panel-subtitle">Ogni errore indica foglio, riga e campo da correggere</div></div></div>
        <div class="pfw-panel-body">
            @if (Model.Analisi.Errori.Count > 0)
            {
                <div class="alert alert-danger">Il file contiene @Model.Analisi.Errori.Count errori e non può essere applicato.</div>
                <div class="table-responsive"><table class="table pfw-table align-middle mb-0"><thead><tr><th>Foglio</th><th>Riga</th><th>Campo</th><th>Errore</th></tr></thead><tbody>
                @foreach (var errore in Model.Analisi.Errori)
                {
                    <tr><td>@errore.Foglio</td><td>@(errore.Riga > 0 ? errore.Riga : "-")</td><td>@errore.Campo</td><td>@errore.Messaggio</td></tr>
                }
                </tbody></table></div>
            }
            else
            {
                <div class="alert alert-success">File valido. Nessun dato è stato ancora scritto nel database.</div>
                <div class="row g-3">
                    <div class="col-12 col-md-4"><div class="pfw-summary-card"><div class="pfw-summary-label">Nodi</div><div class="pfw-summary-value">@Model.Analisi.Nodi.Count</div></div></div>
                    <div class="col-12 col-md-4"><div class="pfw-summary-card"><div class="pfw-summary-label">Materiali</div><div class="pfw-summary-value">@Model.Analisi.Materiali.Count</div></div></div>
                    <div class="col-12 col-md-4"><div class="pfw-summary-card"><div class="pfw-summary-label">Lavorazioni</div><div class="pfw-summary-value">@Model.Analisi.Lavorazioni.Count</div></div></div>
                </div>

                <h3 class="h5 mt-4">Anteprima nodi</h3>
                <div class="table-responsive">
                    <table class="table pfw-table align-middle mb-0">
                        <thead><tr><th>Riga</th><th>Chiave</th><th>Padre</th><th>Tipo</th><th>Descrizione</th><th>Quantità</th><th>Ordine</th><th>Stato</th></tr></thead>
                        <tbody>
                        @foreach (var nodo in Model.Analisi.Nodi.Take(100))
                        {
                            <tr><td>@nodo.RigaExcel</td><td>@nodo.ChiaveNodo</td><td>@(nodo.ChiavePadre ?? "-")</td><td>@nodo.TipoNodo</td><td>@nodo.DescrizioneNodo</td><td>@nodo.QuantitaBase.ToString("N4")</td><td>@nodo.OrdineVisualizzazione</td><td>@(nodo.Attivo ? "Attivo" : "Non attivo")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.Analisi.Nodi.Count > 100)
                {
                    <div class="pfw-secondary-text mt-2">Sono mostrate le prime 100 righe nodo.</div>
                }

                @if (Model.Analisi.Materiali.Count > 0)
                {
                    <h3 class="h5 mt-4">Anteprima materiali</h3>
                    <div class="table-responsive">
                        <table class="table pfw-table align-middle mb-0">
                            <thead><tr><th>Riga</th><th>Chiave nodo</th><th>Materiale</th><th>Quantità</th><th>Scarto %</th><th>Costo unitario</th></tr></thead>
                            <tbody>
                            @foreach (var materiale in Model.Analisi.Materiali.Take(100))
                            {
                                <tr><td>@materiale.RigaExcel</td><td>@materiale.ChiaveNodo</td><td>@materiale.CodiceMateriale</td><td>@materiale.Quantita.ToString("N4")</td><td>@materiale.CoeffScartoPerc.ToString("N2")</td><td>@materiale.CostoUnitario.ToString("C4")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Analisi.Materiali.Count > 100)
                    {
                        <div class="pfw-secondary-text mt-2">Sono mostrate le prime 100 righe materiale.</div>
                    }
                }

                @if (Model.Analisi.Lavorazioni.Count > 0)
                {
                    <h3 class="h5 mt-4">Anteprima lavorazioni</h3>
                    <div class="table-responsive">
                        <table class="table pfw-table align-middle mb-0">
                            <thead><tr><th>Riga</th><th>Chiave nodo</th><th>Lavorazione</th><th>Sequenza</th><th>Setup min</th><th>Tempo pezzo min</th><th>Costo orario</th><th>Costo fisso</th></tr></thead>
                            <tbody>
                            @foreach (var lavorazione in Model.Analisi.Lavorazioni.Take(100))
                            {
                                <tr><td>@lavorazione.RigaExcel</td><td>@lavorazione.ChiaveNodo</td><td>@lavorazione.CodiceLavorazione</td><td>@lavorazione.Sequenza</td><td>@lavorazione.TempoSetupMin.ToString("N2")</td><td>@lavorazione.TempoPezzoMin.ToString("N4")</td><td>@lavorazione.CostoOrario.ToString("C4")</td><td>@lavorazione.CostoFisso.ToString("C4")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Analisi.Lavorazioni.Count > 100)
                    {
                        <div class="pfw-secondary-text mt-2">Sono mostrate le prime 100 righe lavorazione.</div>
                    }
                }
            }
        </div>
        @if (Model.Analisi.Valida)
        {
            <div class="pfw-panel-footer d-flex justify-content-end gap-2">
                <form method="post" asp-page-handler="Applica">
                    <input asp-for="Dati.ContenutoBase64" type="hidden" />
                    <input asp-for="Dati.NomeFile" type="hidden" />
                    <input asp-for="Dati.ImprontaSha256" type="hidden" />
                    <input asp-for="Dati.VersioneRigaBase64" type="hidden" />
                    <button type="submit" class="pfw-btn pfw-btn-primary" onclick="return confirm('Confermare l’importazione della distinta? L’operazione sarà applicata in un’unica transazione.');">Conferma importazione</button>
                </form>
            </div>
        }
    </section>
}

<div><a asp-page="../Dettaglio" asp-route-idArticolo="@revisione.IdArticolo" asp-route-idRevisione="@revisione.IdRevisioneDistinta" class="pfw-btn pfw-btn-secondary">Torna alla distinta</a></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
