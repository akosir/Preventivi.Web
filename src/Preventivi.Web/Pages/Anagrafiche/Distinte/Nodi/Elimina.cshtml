@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Nodi.EliminaModel
@{ var nodo = Model.Nodo!; ViewData["Title"] = "Elimina nodo distinta"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="./Dettaglio" asp-route-id="@nodo.IdNodoDistinta">Dettaglio nodo</a></div><h1 class="h3 mb-0">Elimina nodo distinta</h1></div>
<section class="pfw-panel"><div class="pfw-panel-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><p>Confermi l'eliminazione definitiva del nodo <strong>@nodo.DescrizioneNodo</strong>?</p><p class="pfw-secondary-text mb-0">L'operazione e consentita soltanto se il nodo non contiene figli, materiali, lavorazioni, allegati o riferimenti operativi.</p></div><div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="./Dettaglio" asp-route-id="@nodo.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a><form method="post"><input type="hidden" name="versioneRigaBase64" value="@Convert.ToBase64String(nodo.VersioneRiga)" /><button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button></form></div></section>
