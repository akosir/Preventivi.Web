@page "{id:int}"
@model global::Preventivi.Web.Pages.Anagrafiche.Distinte.Nodi.ModificaModel
@{ ViewData["Title"] = "Modifica nodo distinta"; }
<div class="mb-3"><div class="pfw-secondary-text mb-1"><a asp-page="./Dettaglio" asp-route-id="@Model.Nodo!.IdNodoDistinta">Dettaglio nodo</a></div><h1 class="h3 mb-0">Modifica nodo distinta</h1></div>
<section class="pfw-panel">
    <form method="post">
        <div class="pfw-panel-body"><partial name="Shared/Anagrafiche/_DistintaNodoForm" model="Model.Dati" view-data="Model.ViewData" /></div>
        <div class="pfw-panel-footer d-flex justify-content-end gap-2"><a asp-page="./Dettaglio" asp-route-id="@Model.Nodo!.IdNodoDistinta" class="pfw-btn pfw-btn-secondary">Annulla</a><button type="submit" class="pfw-btn pfw-btn-primary">Salva</button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
