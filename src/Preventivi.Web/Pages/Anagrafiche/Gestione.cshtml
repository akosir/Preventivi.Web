@page "{tipo}"
@model global::Preventivi.Web.Pages.Anagrafiche.GestioneModel

@{
    ViewData["Title"] = Model.Pagina?.Titolo ?? "Anagrafica";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="pfw-secondary-text mb-1"><a asp-page="./Index">Anagrafiche</a></div>
        <h1 class="h3 mb-1">@Model.Pagina!.Titolo</h1>
        <p class="pfw-secondary-text mb-0">Ricerca e gestione dei dati anagrafici</p>
    </div>
    <a asp-page="./Nuovo" asp-route-tipo="@Model.Pagina.Chiave" class="pfw-btn pfw-btn-primary">Nuovo</a>
</div>

@if (TempData["MessaggioSuccesso"] is string messaggio)
{
    <div class="alert alert-success" role="alert">@messaggio</div>
}

<section class="pfw-panel mb-3">
    <div class="pfw-panel-body">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="tipo" value="@Model.Pagina.Chiave" />
            <div class="col-12 col-lg-7">
                <label asp-for="Ricerca" class="form-label">Codice o descrizione</label>
                <input asp-for="Ricerca" class="form-control" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Stato" class="form-label">Stato</label>
                <select asp-for="Stato" class="form-select">
                    <option value="attivi">Attivi</option>
                    <option value="nonattivi">Non attivi</option>
                    <option value="tutti">Tutti</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="pfw-btn pfw-btn-primary flex-grow-1">Cerca</button>
                <a asp-page="./Gestione" asp-route-tipo="@Model.Pagina.Chiave" class="pfw-btn pfw-btn-secondary">Azzera</a>
            </div>
        </form>
    </div>
</section>

<section class="pfw-panel">
    @if (Model.Elementi.Count == 0)
    {
        <div class="pfw-panel-body">
            @await Html.PartialAsync(
                "Shared/PFW/EmptyState/_PFWEmptyState",
                new global::Preventivi.Web.UI.EmptyState.PFWEmptyStateModel
                {
                    Titolo = "Nessun risultato",
                    Messaggio = "Non sono presenti elementi corrispondenti ai filtri selezionati."
                })
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table pfw-table align-middle mb-0">
                <thead>
                    <tr>
                        @if (Model.Pagina.MostraCodice)
                        {
                            <th>Codice</th>
                        }
                        <th>Descrizione</th>
                        <th>Stato</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Elementi)
                    {
                        <tr>
                            @if (Model.Pagina.MostraCodice)
                            {
                                <td class="fw-semibold">@elemento.Codice</td>
                            }
                            <td>@elemento.Descrizione</td>
                            <td>
                                <span class="pfw-badge @(elemento.Attivo ? "pfw-badge-success" : "pfw-badge-secondary")">
                                    @(elemento.Attivo ? "Attivo" : "Non attivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="./Dettaglio" asp-route-tipo="@Model.Pagina.Chiave" asp-route-id="@elemento.Id" class="pfw-btn pfw-btn-secondary">Apri</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
