@model global::Preventivi.Web.UI.Modules.Anagrafiche.ModelloCicloRigaFormModel
@using global::Preventivi.Core.Anagrafiche
@using System.Globalization
@{
    var lavorazioni = ViewData["Lavorazioni"] as IReadOnlyList<ModelloCicloLavorazioneLookupItem> ?? [];
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="VersioneRigaBase64" type="hidden" />
<div class="row g-3">
    <div class="col-12 col-md-3">
        <label asp-for="RigaNr" class="form-label">Numero riga *</label>
        <input asp-for="RigaNr" class="form-control pfw-required" inputmode="numeric" />
        <span asp-validation-for="RigaNr" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="Sequenza" class="form-label">Sequenza *</label>
        <input asp-for="Sequenza" class="form-control pfw-required" inputmode="numeric" />
        <span asp-validation-for="Sequenza" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="IdLavorazione" class="form-label">Lavorazione *</label>
        <select asp-for="IdLavorazione" class="form-select pfw-required" id="modello-ciclo-lavorazione">
            <option value="">Seleziona la lavorazione</option>
            @foreach (var lavorazione in lavorazioni)
            {
                <option value="@lavorazione.IdLavorazione"
                        data-costo="@lavorazione.CostoOrarioStandard.ToString(CultureInfo.InvariantCulture)"
                        data-setup="@lavorazione.TempoSetupMinDefault.ToString(CultureInfo.InvariantCulture)"
                        data-pezzo="@lavorazione.TempoPezzoMinDefault.ToString(CultureInfo.InvariantCulture)">
                    @lavorazione.Display@(lavorazione.Attiva ? "" : " (non attiva)")
                </option>
            }
        </select>
        <span asp-validation-for="IdLavorazione" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="TempoSetupMin" class="form-label">Tempo setup (min) *</label>
        <input asp-for="TempoSetupMin" class="form-control pfw-required" inputmode="decimal" id="modello-ciclo-setup" />
        <span asp-validation-for="TempoSetupMin" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="TempoPezzoMin" class="form-label">Tempo per pezzo (min) *</label>
        <input asp-for="TempoPezzoMin" class="form-control pfw-required" inputmode="decimal" id="modello-ciclo-pezzo" />
        <span asp-validation-for="TempoPezzoMin" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="CostoOrario" class="form-label">Costo orario *</label>
        <input asp-for="CostoOrario" class="form-control pfw-required" inputmode="decimal" id="modello-ciclo-costo" />
        <span asp-validation-for="CostoOrario" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="CostoFisso" class="form-label">Costo fisso *</label>
        <input asp-for="CostoFisso" class="form-control pfw-required" inputmode="decimal" />
        <span asp-validation-for="CostoFisso" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Note" class="form-label">Note operative</label>
        <textarea asp-for="Note" class="form-control" rows="4" maxlength="500"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>
</div>

<script>
    (() => {
        const select = document.getElementById("modello-ciclo-lavorazione");
        if (!select) return;
        select.addEventListener("change", () => {
            const option = select.options[select.selectedIndex];
            if (!option?.value) return;
            document.getElementById("modello-ciclo-setup").value = option.dataset.setup ?? "0";
            document.getElementById("modello-ciclo-pezzo").value = option.dataset.pezzo ?? "0";
            document.getElementById("modello-ciclo-costo").value = option.dataset.costo ?? "0";
        });
    })();
</script>
