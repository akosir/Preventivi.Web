@model global::Preventivi.Web.UI.Toolbar.PFWToolbarModel

<div class="pfw-toolbar">

    <div class="pfw-toolbar-left">

        <div>

            <h2 class="pfw-toolbar-title">
                @Model.Titolo
            </h2>

            @if (!string.IsNullOrWhiteSpace(Model.Sottotitolo))
            {
                <div class="pfw-toolbar-subtitle">
                    @Model.Sottotitolo
                </div>
            }

        </div>

    </div>

    <div class="pfw-toolbar-right">

        @foreach (var pulsante in Model.Pulsanti.Where(p => p.Visibile))
        {
            if (!string.IsNullOrWhiteSpace(pulsante.Url))
            {
                <a href="@pulsante.Url"
                   class="pfw-btn @pulsante.CssClass @(pulsante.Abilitato ? "" : "disabled")">

                    @if (!string.IsNullOrWhiteSpace(pulsante.Icona))
                    {
                        <i class="@pulsante.Icona"></i>
                    }

                    @pulsante.Testo

                </a>
            }
            else
            {
                <button type="button"
                        class="pfw-btn @pulsante.CssClass"
                        onclick="@pulsante.OnClick"
                        disabled="@(!pulsante.Abilitato)">

                    @if (!string.IsNullOrWhiteSpace(pulsante.Icona))
                    {
                        <i class="@pulsante.Icona"></i>
                    }

                    @pulsante.Testo

                </button>
            }
        }

    </div>

</div>