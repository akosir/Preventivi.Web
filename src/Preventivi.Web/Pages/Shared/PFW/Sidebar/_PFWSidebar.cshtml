@model global::Preventivi.Web.UI.Sidebar.PFWSidebarModel

<aside class="pfw-sidebar">

    <div class="pfw-sidebar-header">

        @if (!string.IsNullOrWhiteSpace(Model.Logo))
        {
            <img src="@Model.Logo"
                 alt=""
                 class="pfw-sidebar-logo" />
        }

        <div class="pfw-sidebar-brand">

            <div class="pfw-sidebar-title">
                @Model.Titolo
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Sottotitolo))
            {
                <div class="pfw-sidebar-subtitle">
                    @Model.Sottotitolo
                </div>
            }

        </div>

    </div>

    <nav class="pfw-sidebar-body"
         aria-label="Navigazione principale">

        @foreach (var gruppo in Model.Gruppi)
        {
            if (!gruppo.Visibile)
            {
                continue;
            }

            <details id="@gruppo.Id"
                     class="pfw-sidebar-group"
                     open="@gruppo.Espanso">

                <summary class="pfw-sidebar-group-header">

                    <span class="pfw-sidebar-group-label">

                        @if (!string.IsNullOrWhiteSpace(gruppo.Icona))
                        {
                            <i class="@gruppo.Icona"
                               aria-hidden="true"></i>
                        }

                        <span>
                            @gruppo.Titolo
                        </span>

                    </span>

                    <span class="pfw-sidebar-chevron"
                          aria-hidden="true">
                        ›
                    </span>

                </summary>

                <div class="pfw-sidebar-group-items">

                    @foreach (var voce in gruppo.Voci)
                    {
                        if (!voce.Visibile)
                        {
                            continue;
                        }

                        var cssClass = "pfw-sidebar-item";

                        if (voce.Attiva)
                        {
                            cssClass += " pfw-sidebar-item-active";
                        }

                        if (voce.Disabilitata)
                        {
                            cssClass += " pfw-sidebar-item-disabled";
                        }

                        if (!voce.Disabilitata &&
                            !string.IsNullOrWhiteSpace(voce.Url))
                        {
                            <a id="@voce.Id"
                               href="@voce.Url"
                               class="@cssClass">

                                @if (!string.IsNullOrWhiteSpace(voce.Icona))
                                {
                                    <i class="@voce.Icona"
                                       aria-hidden="true"></i>
                                }

                                <span>
                                    @voce.Testo
                                </span>

                            </a>
                        }
                        else
                        {
                            <span id="@voce.Id"
                                  class="@cssClass">

                                @if (!string.IsNullOrWhiteSpace(voce.Icona))
                                {
                                    <i class="@voce.Icona"
                                       aria-hidden="true"></i>
                                }

                                <span>
                                    @voce.Testo
                                </span>

                            </span>
                        }
                    }

                </div>

            </details>
        }

    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.Footer))
    {
        <div class="pfw-sidebar-footer">
            @Model.Footer
        </div>
    }

</aside>