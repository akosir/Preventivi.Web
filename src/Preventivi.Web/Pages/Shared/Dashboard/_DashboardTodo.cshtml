@model global::Preventivi.Web.UI.Modules.Dashboard.DashboardTodoModel

<div class="pfw-panel h-100">

    <div class="pfw-panel-header">

        <div>

            <h3 class="pfw-panel-title">
                @Model.Titolo
            </h3>

            @if (!string.IsNullOrWhiteSpace(Model.Sottotitolo))
            {
                <div class="pfw-panel-subtitle">
                    @Model.Sottotitolo
                </div>
            }

        </div>

    </div>

    <div class="pfw-panel-body">

        @if (!Model.Elementi.Any())
        {
            @await Html.PartialAsync(
                "Shared/PFW/EmptyState/_PFWEmptyState",
                new global::Preventivi.Web.UI.EmptyState.PFWEmptyStateModel
                {
                    Titolo = "Nessuna attività da svolgere",
                    Messaggio = "Ottimo lavoro!"
                })
        }
        else
        {
            <div class="d-flex flex-column gap-3">

                @foreach (var item in Model.Elementi)
                {
                    <a href="@item.Url"
                       class="text-decoration-none text-reset">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="fw-semibold">
                                    @item.Titolo
                                </div>

                                <div class="small text-muted">
                                    @item.Descrizione
                                </div>

                            </div>

                            @await Html.PartialAsync(
                                "Shared/PFW/Badge/_PFWBadge",
                                new global::Preventivi.Web.UI.Badge.PFWBadgeModel
                                {
                                    Testo = item.Quantita.ToString(),
                                    Variante = item.VarianteBadge
                                })

                        </div>

                    </a>
                }

            </div>
        }

    </div>

</div>