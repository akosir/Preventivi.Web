@model IReadOnlyList<global::Preventivi.Core.OrdiniFornitori.OrdineFornitoreDipendenza>
<table class="table pfw-table">
    <thead><tr><th>Dipendenza</th><th>Numero</th></tr></thead>
    <tbody>
    @foreach (var dipendenza in Model)
    {
        <tr><td>@dipendenza.Tipo</td><td>@dipendenza.Numero</td></tr>
    }
    </tbody>
</table>
