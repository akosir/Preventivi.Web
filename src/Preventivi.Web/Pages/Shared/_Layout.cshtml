<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Preventivi.Web</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/framework/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/badge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/button.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/toolbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/tabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/kpi.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/empty-state.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/framework/tree.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/preventivi.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/preventivo-workspace.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/Preventivi.Web.styles.css" asp-append-version="true" />

   
</head>


<body>

    @{
        var paginaCorrente = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        bool PaginaEsatta(string pagina) =>
            paginaCorrente.Equals(pagina, StringComparison.OrdinalIgnoreCase);
        bool PaginaInArea(string prefisso) =>
            paginaCorrente.Equals(prefisso, StringComparison.OrdinalIgnoreCase) ||
            paginaCorrente.StartsWith(prefisso + "/", StringComparison.OrdinalIgnoreCase);

        var puoPreventivi = global::Preventivi.Web.Sicurezza.AutorizzazioneApplicazione.PuoAccedereAlPermesso(
            User,
            global::Preventivi.Core.Sicurezza.PermessiApplicazione.Preventivi);
        var puoRichieste = global::Preventivi.Web.Sicurezza.AutorizzazioneApplicazione.PuoAccedereAlPermesso(
            User,
            global::Preventivi.Core.Sicurezza.PermessiApplicazione.RichiesteClienti);
        var puoCampionature = global::Preventivi.Web.Sicurezza.AutorizzazioneApplicazione.PuoAccedereAlPermesso(
            User,
            global::Preventivi.Core.Sicurezza.PermessiApplicazione.Campionature);
        var puoClienti = global::Preventivi.Web.Sicurezza.AutorizzazioneApplicazione.PuoAccedereAlPermesso(
            User,
            global::Preventivi.Core.Sicurezza.PermessiApplicazione.Clienti);
        var puoAnagrafiche = global::Preventivi.Web.Sicurezza.AutorizzazioneApplicazione.PuoAccedereAlPermesso(
            User,
            global::Preventivi.Core.Sicurezza.PermessiApplicazione.Anagrafiche);

        var modelliPreventivoAttivi = PaginaInArea("/Preventivi/Modelli");
        var preventiviAttivi = PaginaInArea("/Preventivi") && !modelliPreventivoAttivi;
    }

    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="app-sidebar">

            <div class="app-brand">
                <div class="app-brand-logo">
                    P
                </div>

                <div class="app-brand-text">
                    <div class="app-brand-title">Preventivi</div>
                    <div class="app-brand-subtitle">Web</div>
                </div>
            </div>

            <nav class="app-menu">

                <a class="app-menu-home @(PaginaEsatta("/Index") ? "active" : string.Empty)"
                   asp-page="/Index">
                    <span class="app-menu-home-icon" aria-hidden="true">⌂</span>
                    <span class="app-menu-home-copy">Dashboard</span>
                </a>

                @if (puoRichieste || puoCampionature || puoPreventivi)
                {
                    <div class="app-menu-section">
                        Flusso preventivo
                    </div>

                    <div class="app-process" aria-label="Fasi del ciclo preventivo">
                        @if (puoRichieste)
                        {
                            <a class="app-process-step @(PaginaInArea("/RichiesteClienti") ? "active" : string.Empty)"
                               asp-page="/RichiesteClienti/Index">
                                <span class="app-process-number">1</span>
                                <span class="app-process-copy">
                                    <strong>Richiesta cliente</strong>
                                    <small>Esigenza commerciale</small>
                                </span>
                                <span class="app-process-chevron" aria-hidden="true">›</span>
                            </a>
                        }

                        @if (puoCampionature)
                        {
                            <a class="app-process-step @(PaginaInArea("/Campionature") ? "active" : string.Empty)"
                               asp-page="/Campionature/Index">
                                <span class="app-process-number">2</span>
                                <span class="app-process-copy">
                                    <strong>Campionatura</strong>
                                    <small>Verifica del campione</small>
                                </span>
                                <span class="app-process-chevron" aria-hidden="true">›</span>
                            </a>
                        }

                        @if (puoPreventivi)
                        {
                            <a class="app-process-step @(preventiviAttivi ? "active" : string.Empty)"
                               asp-page="/Preventivi/Index">
                                <span class="app-process-number">3</span>
                                <span class="app-process-copy">
                                    <strong>Preventivo</strong>
                                    <small>Offerta economica</small>
                                </span>
                                <span class="app-process-chevron" aria-hidden="true">›</span>
                            </a>
                        }

                        <div class="app-process-step is-disabled"
                             aria-disabled="true"
                             title="Gestione non ancora disponibile">
                            <span class="app-process-number">4</span>
                            <span class="app-process-copy">
                                <strong>Ordini fornitori</strong>
                                <small>Approvvigionamento</small>
                            </span>
                            <span class="app-process-status">Da attivare</span>
                        </div>
                    </div>
                }

                @if (puoPreventivi)
                {
                    <div class="app-menu-section">Strumenti</div>
                    <a class="app-menu-item @(modelliPreventivoAttivi ? "active" : string.Empty)"
                       asp-page="/Preventivi/Modelli/Index">
                        <span class="app-menu-item-symbol" aria-hidden="true">M</span>
                        <span>Modelli preventivo</span>
                    </a>
                }

                @if (puoClienti || puoAnagrafiche)
                {
                    <div class="app-menu-section">Dati di base</div>

                    @if (puoClienti)
                    {
                        <a class="app-menu-item @(PaginaInArea("/Clienti") ? "active" : string.Empty)"
                           asp-page="/Clienti/Index">
                            <span class="app-menu-item-symbol" aria-hidden="true">C</span>
                            <span>Clienti</span>
                        </a>
                    }

                    @if (puoAnagrafiche)
                    {
                        <a class="app-menu-item @(PaginaInArea("/Anagrafiche") ? "active" : string.Empty)"
                           asp-page="/Anagrafiche/Index">
                            <span class="app-menu-item-symbol" aria-hidden="true">A</span>
                            <span>Anagrafiche</span>
                        </a>
                    }
                }

            </nav>

        </aside>

        <!-- MAIN AREA -->
        <div class="app-main">

            <!-- HEADER -->
            <header class="app-header">

                <div>
                    <div class="app-page-title">
                        @ViewData["Title"]
                    </div>
                </div>

                @{
                    var nomeUtente = User.FindFirst(
                        global::System.Security.Claims.ClaimTypes.GivenName)?.Value
                        ?? User.Identity?.Name
                        ?? "Utente";
                    var inizialeUtente = nomeUtente.Length > 0
                        ? nomeUtente[..1].ToUpperInvariant()
                        : "U";
                }

                <div class="app-user">

                    <span class="app-user-name">
                        @nomeUtente
                    </span>

                    <div class="app-user-avatar">
                        @inizialeUtente
                    </div>

                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit"
                                class="pfw-btn pfw-btn-secondary">
                            Esci
                        </button>
                    </form>

                </div>

            </header>

            <!-- CONTENT -->
            <main class="app-content">

                @RenderBody()

            </main>

            <!-- FOOTER -->
            <footer class="app-footer">
                Preventivi.Web &copy; 2026
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
