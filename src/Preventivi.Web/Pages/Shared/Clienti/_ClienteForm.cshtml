@model global::Preventivi.Web.UI.Modules.Clienti.ClienteFormModel

<div class="pfw-panel">

    <div class="pfw-panel-body">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-3">
        </div>

        <div class="row g-3">

            <div class="col-md-3">

                <label asp-for="CodiceCliente" class="form-label"></label>

                <input asp-for="CodiceCliente"
                       class="form-control" />

                <span asp-validation-for="CodiceCliente"
                      class="text-danger"></span>

            </div>

            <div class="col-md-9">

                <label asp-for="RagioneSociale"
                       class="form-label"></label>

                <input asp-for="RagioneSociale"
                       class="form-control" />

                <span asp-validation-for="RagioneSociale"
                      class="text-danger"></span>

            </div>

            <div class="col-md-4">

                <label asp-for="PartitaIVA"
                       class="form-label"></label>

                <input asp-for="PartitaIVA"
                       class="form-control" />

            </div>

            <div class="col-md-4">

                <label asp-for="CodiceFiscale"
                       class="form-label"></label>

                <input asp-for="CodiceFiscale"
                       class="form-control" />

            </div>

            <div class="col-md-4 d-flex align-items-end">

                <div class="form-check">

                    <input asp-for="Attivo"
                           class="form-check-input" />

                    <label asp-for="Attivo"
                           class="form-check-label"></label>

                </div>

            </div>

            <div class="col-md-12">

                <label asp-for="Indirizzo"
                       class="form-label"></label>

                <input asp-for="Indirizzo"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <label asp-for="CAP"
                       class="form-label"></label>

                <input asp-for="CAP"
                       class="form-control" />

            </div>

            <div class="col-md-6">

                <label asp-for="Citta"
                       class="form-label"></label>

                <input asp-for="Citta"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <label asp-for="Provincia"
                       class="form-label"></label>

                <input asp-for="Provincia"
                       class="form-control" />

            </div>

            <div class="col-md-6">

                <label asp-for="Telefono"
                       class="form-label"></label>

                <input asp-for="Telefono"
                       class="form-control" />

            </div>

            <div class="col-md-6">

                <label asp-for="Email"
                       class="form-label"></label>

                <input asp-for="Email"
                       class="form-control" />

            </div>

        </div>

    </div>

</div>