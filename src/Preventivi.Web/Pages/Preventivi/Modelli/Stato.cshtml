@page
@model global::Preventivi.Web.Pages.Preventivi.Modelli.StatoModel

@{
    var modello = Model.Modello!;
    ViewData["Title"] = Model.Attivo ? "Riattiva modello" : "Elimina modello";
}

<div class="workspace-page preventivi-page">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="./Index">Modelli preventivo</a>
            <span>/</span>
            <a asp-page="./Dettaglio" asp-route-id="@modello.IdModelloPreventivo">@modello.CodiceModelloPreventivo</a>
            <span>/</span>
            <span>@(Model.Attivo ? "Riattiva" : "Elimina")</span>
        </div>
        <h1 class="workspace-title">@(Model.Attivo ? "Riattiva modello preventivo" : "Elimina modello preventivo")</h1>
    </div>

    <section class="pfw-panel">
        <div class="pfw-panel-body">
            <p>
                @if (Model.Attivo)
                {
                    <text>Confermi la riattivazione del modello <strong>@modello.CodiceModelloPreventivo - @modello.Descrizione</strong>?</text>
                }
                else
                {
                    <text>Confermi la disattivazione del modello <strong>@modello.CodiceModelloPreventivo - @modello.Descrizione</strong>? I preventivi gia creati conserveranno il riferimento storico.</text>
                }
            </p>

            <form method="post" class="preventivi-form-actions">
                <input asp-for="Id" type="hidden" />
                <input asp-for="Attivo" type="hidden" />
                <a asp-page="./Dettaglio" asp-route-id="@modello.IdModelloPreventivo" class="pfw-btn pfw-btn-secondary">Annulla</a>
                <button type="submit" class="pfw-btn @(Model.Attivo ? "pfw-btn-primary" : "pfw-btn-danger")">
                    @(Model.Attivo ? "Riattiva" : "Elimina")
                </button>
            </form>
        </div>
    </section>
</div>
