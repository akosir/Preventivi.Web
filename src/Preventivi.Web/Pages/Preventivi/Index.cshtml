@page
@model Preventivi.IndexModel

@{
    ViewData["Title"] = "Preventivi";
}

<div class="preventivi-page">
    <header class="preventivi-page-header">
        <div>
            <h1 class="preventivi-page-title">Preventivi</h1>
            <div class="preventivi-page-subtitle">
                Consulta i preventivi clienti e accedi al dettaglio operativo.
            </div>
        </div>
    </header>

    <section class="pfw-panel" aria-labelledby="elenco-preventivi-title">
        <div class="pfw-panel-header">
            <div>
                <h2 id="elenco-preventivi-title" class="pfw-panel-title">
                    Elenco preventivi
                </h2>
                <div class="pfw-panel-subtitle">
                    @Model.Preventivi.Count @(Model.Preventivi.Count == 1 ? "preventivo trovato" : "preventivi trovati")
                </div>
            </div>
        </div>

        @if (Model.Preventivi.Count == 0)
        {
            <div class="pfw-empty-row">Nessun preventivo disponibile.</div>
        }
        else
        {
            <div class="preventivi-table-wrap">
                <table class="table pfw-table preventivi-table align-middle">
                    <thead>
                        <tr>
                            <th>Preventivo</th>
                            <th>Cliente</th>
                            <th>Oggetto</th>
                            <th>Data</th>
                            <th class="text-end">Totale vendita</th>
                            <th>Stato</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var preventivo in Model.Preventivi)
                        {
                            <tr>
                                <td>
                                    <div class="preventivi-cell-primary">@preventivo.NumeroCompleto</div>
                                    <div class="preventivi-cell-secondary">Preventivo cliente</div>
                                </td>
                                <td class="fw-semibold">@preventivo.Cliente</td>
                                <td>@preventivo.Oggetto</td>
                                <td>@preventivo.DataPreventivo.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold">@preventivo.TotaleVendita.ToString("C2")</td>
                                <td>
                                    <span class="pfw-badge @GetStatoBadge(preventivo.Stato)">
                                        @preventivo.Stato
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="preventivi-actions">
                                        <a asp-page="/Preventivi/Dettaglio"
                                           asp-route-id="@preventivo.IdPreventivo"
                                           class="pfw-btn pfw-btn-secondary pfw-btn-compact">
                                            Apri
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@functions {
    private static string GetStatoBadge(string stato)
    {
        return stato switch
        {
            "Accettato" => "pfw-badge-success",
            "Pronto da Inviare" or "Da Verificare" => "pfw-badge-warning",
            "Respinto" or "Annullato" => "pfw-badge-danger",
            "Inviato" or "In Produzione" => "pfw-badge-primary",
            _ => "pfw-badge-secondary"
        };
    }
}
