@page
@model Preventivi.IndexModel

@{
    ViewData["Title"] = "Preventivi";
}

<div class="preventivi-page">
    <header class="preventivi-page-header">
        <div>
            <h1 class="preventivi-page-title">Preventivi</h1>
            <div class="preventivi-page-subtitle">
                Consulta i preventivi clienti e accedi al dettaglio operativo.
            </div>
        </div>
        <a asp-page="/Preventivi/Nuovo" class="pfw-btn pfw-btn-primary">
            Nuovo preventivo
        </a>
    </header>

    <section class="pfw-panel preventivi-search-panel" aria-labelledby="ricerca-preventivi-title">
        <div class="pfw-panel-header">
            <div>
                <h2 id="ricerca-preventivi-title" class="pfw-panel-title">Ricerca preventivi</h2>
                <div class="pfw-panel-subtitle">Filtra per numero, cliente, oggetto, stato e data.</div>
            </div>
        </div>

        <form method="get" class="preventivi-search-form">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label asp-for="Ricerca" class="form-label">Numero, cliente o oggetto</label>
                    <input asp-for="Ricerca" class="form-control" autocomplete="off" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Stato" class="form-label">Stato</label>
                    <select asp-for="Stato" class="form-select">
                        <option value="">Tutti</option>
                        @foreach (var stato in Model.Stati)
                        {
                            <option value="@stato">@stato</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Anno" class="form-label">Anno</label>
                    <select asp-for="Anno" class="form-select">
                        <option value="">Tutti</option>
                        @foreach (var anno in Model.Anni)
                        {
                            <option value="@anno">@anno</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="DataDa" class="form-label">Data da</label>
                    <input asp-for="DataDa" type="date" class="form-control" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="DataA" class="form-label">Data a</label>
                    <input asp-for="DataA" type="date" class="form-control" />
                </div>
            </div>
            <div class="preventivi-search-actions">
                @if (Model.HaFiltri)
                {
                    <a asp-page="/Preventivi/Index" class="pfw-btn pfw-btn-secondary">Azzera</a>
                }
                <button type="submit" class="pfw-btn pfw-btn-primary">Cerca</button>
            </div>
        </form>
    </section>

    <section class="pfw-panel" aria-labelledby="elenco-preventivi-title">
        <div class="pfw-panel-header">
            <div>
                <h2 id="elenco-preventivi-title" class="pfw-panel-title">
                    Elenco preventivi
                </h2>
                <div class="pfw-panel-subtitle">
                    @Model.Preventivi.Count @(Model.Preventivi.Count == 1 ? "preventivo trovato" : "preventivi trovati")
                </div>
            </div>
        </div>

        @if (Model.Preventivi.Count == 0)
        {
            <div class="pfw-empty-row">
                @(Model.HaFiltri
                    ? "Nessun preventivo corrisponde ai filtri impostati."
                    : "Nessun preventivo disponibile.")
            </div>
        }
        else
        {
            <div class="preventivi-table-wrap">
                <table class="table pfw-table preventivi-table align-middle">
                    <thead>
                        <tr>
                            <th>Preventivo</th>
                            <th>Cliente</th>
                            <th>Oggetto</th>
                            <th>Data</th>
                            <th class="text-end">Totale vendita</th>
                            <th>Stato</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var preventivo in Model.Preventivi)
                        {
                            <tr>
                                <td>
                                    <div class="preventivi-cell-primary">@preventivo.NumeroCompleto</div>
                                    <div class="preventivi-cell-secondary">Preventivo cliente</div>
                                </td>
                                <td class="fw-semibold">@preventivo.Cliente</td>
                                <td>@preventivo.Oggetto</td>
                                <td>@preventivo.DataPreventivo.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold">@preventivo.TotaleVendita.ToString("C2")</td>
                                <td>
                                    <span class="pfw-badge @GetStatoBadge(preventivo.Stato)">
                                        @preventivo.Stato
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="preventivi-actions">
                                        <a asp-page="/Preventivi/Dettaglio"
                                           asp-route-id="@preventivo.IdPreventivo"
                                           class="pfw-btn pfw-btn-secondary pfw-btn-compact">
                                            Apri
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@functions {
    private static string GetStatoBadge(string stato)
    {
        return stato switch
        {
            "Accettato" => "pfw-badge-success",
            "Pronto da Inviare" or "Da Verificare" => "pfw-badge-warning",
            "Respinto" or "Annullato" => "pfw-badge-danger",
            "Inviato" or "In Produzione" => "pfw-badge-primary",
            _ => "pfw-badge-secondary"
        };
    }
}
