@page
@model Preventivi.DettaglioModel

@{
    ViewData["Title"] = $"Preventivo {Model.Preventivo!.NumeroCompleto}";
}

<div class="workspace-page preventivi-page preventivo-workspace">

    <div class="workspace-header">

        <div class="workspace-breadcrumb">
            <a asp-page="/Index">Dashboard</a>
            <span>/</span>
            <a asp-page="/Preventivi/Index">Preventivi</a>
            <span>/</span>
            <span>@Model.Preventivo.NumeroCompleto</span>
        </div>

        <div class="workspace-top">

            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h1 class="workspace-title mb-0">
                        Preventivo @Model.Preventivo.NumeroCompleto
                    </h1>

                    <span class="pfw-badge @GetStatoBadge(Model.Preventivo.Stato)">
                        @Model.Preventivo.Stato
                    </span>
                </div>

                <div class="workspace-subtitle">
                    @Model.Preventivo.Cliente
                    <span class="mx-1">•</span>
                    @Model.Preventivo.Oggetto
                </div>
            </div>

            <div class="preventivi-actions">
                <a asp-page="/Preventivi/Anteprima"
                   asp-route-id="@Model.Preventivo.IdPreventivo"
                   asp-route-tipo="cliente"
                   class="pfw-btn pfw-btn-secondary">
                    Anteprima cliente
                </a>
                <a asp-page="/Preventivi/Anteprima"
                   asp-route-id="@Model.Preventivo.IdPreventivo"
                   asp-route-tipo="interna"
                   class="pfw-btn pfw-btn-secondary">
                    Anteprima interna
                </a>
                <a asp-page="/Preventivi/Modifica"
                   asp-route-id="@Model.Preventivo.IdPreventivo"
                   class="pfw-btn pfw-btn-primary">
                    Modifica
                </a>
            </div>

        </div>

    </div>

    <section class="pfw-panel">

        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dettaglio preventivo</h2>
                <div class="pfw-panel-subtitle">
                    Dati principali e totali calcolati
                </div>
            </div>
        </div>

        <div class="preventivo-summary-grid">
            <div class="preventivo-data-grid">
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Numero</div>
                    <div class="preventivo-data-value">@Model.Preventivo.NumeroCompleto</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Data preventivo</div>
                    <div class="preventivo-data-value">@Model.Preventivo.DataPreventivo.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="preventivo-data-item preventivo-data-item-wide">
                    <div class="preventivo-data-label">Cliente</div>
                    <div class="preventivo-data-value">
                        @Model.Preventivo.Cliente
                        <span class="ms-2 text-muted">#@Model.Preventivo.IdCliente</span>
                    </div>
                </div>
                <div class="preventivo-data-item preventivo-data-item-wide">
                    <div class="preventivo-data-label">Oggetto</div>
                    <div class="preventivo-data-value preventivo-data-value-multiline">@Model.Preventivo.Oggetto</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Richiesta cliente</div>
                    <div class="preventivo-data-value">@GetRichiestaClienteTesto()</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Markup predefinito</div>
                    <div class="preventivo-data-value justify-content-end">@Model.Preventivo.MarkupPercDefault.ToString("N2") %</div>
                </div>
                <div class="preventivo-data-item preventivo-data-item-wide">
                    <div class="preventivo-data-label">Note</div>
                    <div class="preventivo-data-value preventivo-data-value-multiline">@(string.IsNullOrWhiteSpace(Model.Preventivo.Note) ? "Nessuna nota" : Model.Preventivo.Note)</div>
                </div>
            </div>

            <div class="preventivo-metrics" aria-label="Riepilogo economico">
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Totale costi</span>
                    <strong class="preventivo-metric-value">@Model.Preventivo.TotaleCosti.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric preventivo-metric-primary">
                    <span class="preventivo-metric-label">Totale vendita</span>
                    <strong class="preventivo-metric-value">@Model.Preventivo.TotaleVendita.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Margine valore</span>
                    <strong class="preventivo-metric-value">@Model.Preventivo.MargineValore.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Margine percentuale</span>
                    <strong class="preventivo-metric-value">@Model.Preventivo.MarginePerc.ToString("N2") %</strong>
                </div>
            </div>
        </div>

    </section>

    <section class="pfw-panel">

        <div class="workspace-tabs">

            <a href="#righe-preventivo"
               class="workspace-tab active text-decoration-none">
                Righe Preventivo (@Model.Righe.Count)
            </a>

            <a href="#varianti-preventivo"
               class="workspace-tab text-decoration-none">
                Varianti Preventivo (@Model.Varianti.Count)
            </a>

            <a href="#allegati-preventivo"
               class="workspace-tab text-decoration-none">
                Allegati (@Model.Allegati.Allegati.Count)
            </a>

        </div>

        <div class="workspace-tab-content">

            <div id="righe-preventivo"
                 class="preventivo-section-toolbar">

                <div>
                    <span class="preventivo-section-title">Righe preventivo</span>
                    <span class="preventivo-section-count">
                        @Model.Righe.Count righe
                    </span>
                </div>

                <a asp-page="/Preventivi/Riga/Nuovo"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   class="pfw-btn pfw-btn-primary">
                    Nuova riga
                </a>

            </div>

            @if (Model.Righe.Count == 0)
            {
                <div class="workspace-placeholder">

                    <div class="workspace-placeholder-title">
                        Nessuna riga presente
                    </div>

                    <div class="workspace-placeholder-text">
                        Il preventivo non contiene ancora righe.
                    </div>

                </div>
            }
            else
            {
                <div class="preventivi-table-wrap">

                    <table class="table pfw-table preventivi-table align-middle">

                        <thead>
                            <tr>
                                <th>Riga</th>
                                <th>Tipo</th>
                                <th>Descrizione</th>
                                <th class="text-end">Quantità</th>
                                <th class="text-end">Prezzo unitario</th>
                                <th class="text-end">Totale vendita</th>
                                <th class="text-end">Totale costi</th>
                                <th class="text-end">Margine %</th>
                                <th class="text-center">Prezzo manuale</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var riga in Model.Righe)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @riga.RigaNr
                                    </td>

                                    <td>
                                        <span class="pfw-badge pfw-badge-secondary">
                                            @riga.TipoRiga
                                        </span>
                                    </td>

                                    <td>
                                        @riga.DescrizioneVoce
                                    </td>

                                    <td class="text-end">
                                        @riga.Quantita.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @riga.PrezzoUnitarioVendita.ToString("C2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @riga.TotaleVendita.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @riga.TotaleCosti.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @riga.MarginePerc.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        <input type="checkbox"
                                               checked="@riga.PrezzoManuale"
                                               disabled />
                                    </td>

                                    <td class="text-end">
                                        <div class="preventivi-actions">
                                            <a asp-page="/Preventivi/Riga/Workspace"
                                               asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                               asp-route-idRigaPreventivo="@riga.IdRigaPreventivo"
                                               class="pfw-btn pfw-btn-secondary pfw-btn-compact">
                                                Apri
                                            </a>
                                            <a asp-page="/Preventivi/Riga/Elimina"
                                               asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                               asp-route-idRigaPreventivo="@riga.IdRigaPreventivo"
                                               class="pfw-btn pfw-btn-danger pfw-btn-compact">
                                                Elimina
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <hr id="varianti-preventivo"
                class="my-4" />

            <div class="preventivo-section-toolbar">
                <div>
                    <span class="preventivo-section-title">Varianti preventivo</span>
                    <span class="preventivo-section-count">
                        @Model.Varianti.Count varianti
                    </span>
                </div>

                <a asp-page="/Preventivi/Varianti/Nuovo"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   class="pfw-btn pfw-btn-primary">
                    Nuova variante
                </a>
            </div>

            @if (Model.Varianti.Count == 0)
            {
                <div class="workspace-placeholder">
                    <div class="workspace-placeholder-title">
                        Nessuna variante presente
                    </div>

                    <div class="workspace-placeholder-text">
                        Il preventivo non contiene ancora varianti.
                    </div>
                </div>
            }
            else
            {
                <div class="preventivi-table-wrap">

                    <table class="table pfw-table preventivi-table align-middle">

                        <thead>
                            <tr>
                                <th>Codice</th>
                                <th>Descrizione</th>
                                <th class="text-center">Scelta</th>
                                <th class="text-end">Totale vendita</th>
                                <th class="text-end">Totale costi</th>
                                <th class="text-end">Margine %</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var variante in Model.Varianti)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @variante.CodiceVariante
                                    </td>

                                    <td>
                                        @variante.DescrizioneVariante
                                    </td>

                                    <td class="text-center">
                                        <input type="checkbox"
                                               checked="@variante.VarianteScelta"
                                               disabled />
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @variante.TotaleVendita.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @variante.TotaleCosti.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @variante.MarginePerc.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        <div class="preventivi-actions">
                                            <a asp-page="/Preventivi/Varianti/Dettaglio"
                                               asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                               asp-route-idVariantePreventivo="@variante.IdVariantePreventivo"
                                               class="pfw-btn pfw-btn-secondary pfw-btn-compact">
                                                Apri
                                            </a>
                                            <a asp-page="/Preventivi/Varianti/Elimina"
                                               asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                               asp-route-idVariantePreventivo="@variante.IdVariantePreventivo"
                                               class="pfw-btn pfw-btn-danger pfw-btn-compact">
                                                Elimina
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <hr id="allegati-preventivo"
                class="my-4" />

            @await Html.PartialAsync(
                "~/Pages/Shared/Allegati/_AllegatiHeader.cshtml",
                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiHeaderModel
                {
                    Titolo = "Allegati preventivo",
                    Sottotitolo = "Documenti associati al preventivo"
                })

            @await Html.PartialAsync(
                "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                {
                    TestoNuovo = "Nuovo Allegato",
                    UrlNuovo =
                        $"/Allegati/Nuovo?Entita=Preventivi&IdEntita={Model.Preventivo.IdPreventivo}",
                    MostraNuovo = true,
                    MostraAggiorna = false
                })

            @if (Model.Allegati.Allegati.Count == 0)
            {
                <div class="workspace-placeholder">

                    <div class="workspace-placeholder-title">
                        Nessun allegato presente
                    </div>

                    <div class="workspace-placeholder-text">
                        Il preventivo non contiene ancora documenti allegati.
                    </div>

                </div>
            }
            else
            {
                @await Html.PartialAsync(
                    "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                    Model.Allegati)
            }

        </div>

    </section>

</div>

@functions
{
    private string GetRichiestaClienteTesto()
    {
        return Model.Preventivo!.IdRichiestaCliente.HasValue
            ? Model.Preventivo.IdRichiestaCliente.Value.ToString()
            : "Assente";
    }

    private static string GetStatoBadge(string stato)
    {
        return stato switch
        {
            "Accettato" => "pfw-badge-success",

            "Pronto da Inviare"
                or "Da Verificare"
                => "pfw-badge-warning",

            "Respinto"
                or "Annullato"
                => "pfw-badge-danger",

            "Inviato"
                or "In Produzione"
                => "pfw-badge-primary",

            _ => "pfw-badge-secondary"
        };
    }
}
