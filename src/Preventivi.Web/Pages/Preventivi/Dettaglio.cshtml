@page
@model Preventivi.DettaglioModel

@{
    ViewData["Title"] = $"Preventivo {Model.Preventivo!.NumeroCompleto}";
}

<div class="workspace-page">

    <div class="workspace-header">

        <div class="workspace-breadcrumb">
            <a asp-page="/Index">Dashboard</a>
            <span>/</span>
            <a asp-page="/Preventivi/Index">Preventivi</a>
            <span>/</span>
            <span>@Model.Preventivo.NumeroCompleto</span>
        </div>

        <div class="workspace-top">

            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h1 class="workspace-title mb-0">
                        Preventivo @Model.Preventivo.NumeroCompleto
                    </h1>

                    <span class="pfw-badge @GetStatoBadge(Model.Preventivo.Stato)">
                        @Model.Preventivo.Stato
                    </span>
                </div>

                <div class="workspace-subtitle">
                    @Model.Preventivo.Cliente
                    <span class="mx-1">•</span>
                    @Model.Preventivo.Oggetto
                </div>
            </div>

        </div>

    </div>

    <section class="pfw-panel mb-3">

        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dettaglio preventivo</h2>
                <div class="pfw-panel-subtitle">
                    Dati principali e totali calcolati
                </div>
            </div>
        </div>

        <div class="p-3">

            <div class="row g-3 align-items-start">

                <div class="col-12 col-xl-5">
                    <div class="row g-2">

                        <div class="col-12 col-md-6">
                            <label class="form-label">NumeroPreventivo</label>
                            <input class="form-control text-end"
                                   value="@Model.Preventivo.NumeroPreventivo"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Anno</label>
                            <input class="form-control text-end"
                                   value="@Model.Preventivo.Anno"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">DataPreventivo</label>
                            <input class="form-control text-end"
                                   value="@Model.Preventivo.DataPreventivo.ToString("dd/MM/yyyy")"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">IdCliente</label>
                            <input class="form-control text-end"
                                   value="@Model.Preventivo.IdCliente"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Cliente</label>
                            <input class="form-control"
                                   value="@Model.Preventivo.Cliente"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Oggetto</label>
                            <textarea class="form-control"
                                      rows="2"
                                      readonly>@Model.Preventivo.Oggetto</textarea>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Stato</label>
                            <input class="form-control"
                                   value="@Model.Preventivo.Stato"
                                   readonly />
                        </div>

                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="row g-2">

                        <div class="col-12">
                            <label class="form-label">TotaleCosti</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Preventivo.TotaleCosti.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">TotaleVendita</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Preventivo.TotaleVendita.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">MargineValore</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Preventivo.MargineValore.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-7">
                            <label class="form-label">Margine %</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Preventivo.MarginePerc.ToString("N2")"
                                   readonly />
                        </div>

                        <div class="col-5">
                            <label class="form-label">Markup</label>
                            <input class="form-control text-end"
                                   value="@Model.Preventivo.MarkupPercDefault.ToString("N2")"
                                   readonly />
                        </div>

                    </div>
                </div>

                <div class="col-12 col-xl-3">
                    <div class="row g-2">

                        <div class="col-12">
                            <label class="form-label">Richiesta Cliente</label>
                            <input class="form-control"
                                   value="@GetRichiestaClienteTesto()"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Note</label>
                            <textarea class="form-control"
                                      rows="5"
                                      readonly>@Model.Preventivo.Note</textarea>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </section>

    <section class="pfw-panel">

        <div class="workspace-tabs">

            <a href="#righe-preventivo"
               class="workspace-tab active text-decoration-none">
                Righe Preventivo (@Model.Righe.Count)
            </a>

            <a href="#varianti-preventivo"
               class="workspace-tab text-decoration-none">
                Varianti Preventivo
            </a>

            <a href="#allegati-preventivo"
               class="workspace-tab text-decoration-none">
                Allegati (@Model.Allegati.Allegati.Count)
            </a>

        </div>

        <div class="workspace-tab-content">

            <div id="righe-preventivo"
                 class="workspace-righe-toolbar">

                <div>
                    <strong>Righe preventivo</strong>
                    <span class="workspace-righe-count">
                        @Model.Righe.Count righe
                    </span>
                </div>

            </div>

            @if (Model.Righe.Count == 0)
            {
                <div class="workspace-placeholder">

                    <div class="workspace-placeholder-title">
                        Nessuna riga presente
                    </div>

                    <div class="workspace-placeholder-text">
                        Il preventivo non contiene ancora righe.
                    </div>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table pfw-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>RigaNr</th>
                                <th>Tipo</th>
                                <th>DescrizioneVoce</th>
                                <th class="text-end">Quantità</th>
                                <th class="text-end">Prezzo Unitario Vendita</th>
                                <th class="text-end">Totale Vendita</th>
                                <th class="text-end">Totale Costi</th>
                                <th class="text-end">Margine %</th>
                                <th class="text-center">Prez. Manuale</th>
                                <th class="text-center">Azioni</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var riga in Model.Righe)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @riga.RigaNr
                                    </td>

                                    <td>
                                        <span class="pfw-badge pfw-badge-secondary">
                                            @riga.TipoRiga
                                        </span>
                                    </td>

                                    <td>
                                        @riga.DescrizioneVoce
                                    </td>

                                    <td class="text-end">
                                        @riga.Quantita.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @riga.PrezzoUnitarioVendita.ToString("C2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @riga.TotaleVendita.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @riga.TotaleCosti.ToString("C2")
                                    </td>

                                    <td class="text-end">
                                        @riga.MarginePerc.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        <input type="checkbox"
                                               checked="@riga.PrezzoManuale"
                                               disabled />
                                    </td>

                                    <td class="text-center">
                                        <a asp-page="/Preventivi/Riga/Workspace"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@riga.IdRigaPreventivo"
                                           class="pfw-action-link">
                                            Apri
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <hr id="varianti-preventivo"
                class="my-4" />

            <div class="workspace-righe-toolbar">
                <div>
                    <strong>Varianti preventivo</strong>
                    <span class="workspace-righe-count">
                        dati non ancora disponibili
                    </span>
                </div>
            </div>

            <div class="workspace-placeholder">
                <div class="workspace-placeholder-title">
                    Modulo varianti non ancora collegato
                </div>

                <div class="workspace-placeholder-text">
                    Nel codice non sono ancora presenti repository o stored procedure
                    per leggere le varianti del preventivo.
                </div>
            </div>

            <hr id="allegati-preventivo"
                class="my-4" />

            @await Html.PartialAsync(
                "~/Pages/Shared/Allegati/_AllegatiHeader.cshtml",
                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiHeaderModel
                {
                    Titolo = "Allegati preventivo",
                    Sottotitolo = "Documenti associati al preventivo"
                })

            @await Html.PartialAsync(
                "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                {
                    TestoNuovo = "Nuovo Allegato",
                    UrlNuovo =
                        $"/Allegati/Nuovo?Entita=Preventivi&IdEntita={Model.Preventivo.IdPreventivo}",
                    MostraNuovo = true,
                    MostraAggiorna = false
                })

            @if (Model.Allegati.Allegati.Count == 0)
            {
                <div class="workspace-placeholder">

                    <div class="workspace-placeholder-title">
                        Nessun allegato presente
                    </div>

                    <div class="workspace-placeholder-text">
                        Il preventivo non contiene ancora documenti allegati.
                    </div>

                </div>
            }
            else
            {
                @await Html.PartialAsync(
                    "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                    Model.Allegati)
            }

        </div>

    </section>

</div>

@functions
{
    private string GetRichiestaClienteTesto()
    {
        return Model.Preventivo!.IdRichiestaCliente.HasValue
            ? Model.Preventivo.IdRichiestaCliente.Value.ToString()
            : "Assente";
    }

    private static string GetStatoBadge(string stato)
    {
        return stato switch
        {
            "Accettato" => "pfw-badge-success",

            "Pronto da Inviare"
                or "Da Verificare"
                => "pfw-badge-warning",

            "Respinto"
                or "Annullato"
                => "pfw-badge-danger",

            "Inviato"
                or "In Produzione"
                => "pfw-badge-primary",

            _ => "pfw-badge-secondary"
        };
    }
}
