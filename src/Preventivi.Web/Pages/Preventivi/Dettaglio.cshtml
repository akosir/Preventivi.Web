@page
@model Preventivi.DettaglioModel

@{
    ViewData["Title"] = "Preventivo 2026-00125";
}

<div class="workspace-header">

    <div class="workspace-breadcrumb">
        <a asp-page="/Index">Dashboard</a>
        <span>/</span>
        <a asp-page="/Preventivi/Index">Preventivi</a>
        <span>/</span>
        <span>2026-00125</span>
    </div>

    <div class="workspace-top">
        <div>
            <h1 class="workspace-title">Preventivo 2026-00125</h1>
            <div class="workspace-subtitle">
                Rossi S.p.A. • Espositore promozionale banco cassa
            </div>
        </div>

        <div class="workspace-actions">
            <button class="pfw-btn pfw-btn-secondary">PDF</button>
            <button class="pfw-btn pfw-btn-secondary">Duplica</button>
            <button class="pfw-btn pfw-btn-primary">Salva</button>
        </div>
    </div>

</div>

<div class="row g-3 mb-3">

    <div class="col-12 col-xl-8">
        <section class="pfw-panel pfw-panel-auto">

            <div class="pfw-panel-header">
                <div>
                    <h2 class="pfw-panel-title">Dati preventivo</h2>
                    <div class="pfw-panel-subtitle">Informazioni generali</div>
                </div>
            </div>

            <div class="p-3">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Cliente</label>
                        <input class="form-control" value="Rossi S.p.A." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Data</label>
                        <input class="form-control" value="20/08/2026" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Stato</label>
                        <select class="form-select">
                            <option>Bozza</option>
                            <option selected>In lavorazione</option>
                            <option>Da inviare</option>
                            <option>Inviato</option>
                            <option>Accettato</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Oggetto</label>
                        <input class="form-control"
                               value="Espositore promozionale banco cassa" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Validità</label>
                        <input class="form-control" value="30 giorni" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Markup default</label>
                        <input class="form-control text-end" value="35,00 %" />
                    </div>

                </div>

            </div>

        </section>
    </div>

    <div class="col-12 col-xl-4">

        <section class="pfw-panel pfw-panel-auto">

            <div class="pfw-panel-header">
                <div>
                    <h2 class="pfw-panel-title">Stato attività</h2>
                </div>
            </div>

            <div class="p-3">

                <div class="workspace-status-row">
                    <span>Richiesta cliente</span>
                    <span class="pfw-badge pfw-badge-success">Collegata</span>
                </div>

                <div class="workspace-status-row">
                    <span>Campionatura</span>
                    <span class="pfw-badge pfw-badge-warning">Aperta</span>
                </div>

                <div class="workspace-status-row">
                    <span>Ordini fornitori</span>
                    <span class="pfw-badge pfw-badge-primary">2 ordini</span>
                </div>

                <div class="workspace-status-row">
                    <span>Allegati</span>
                    <span class="pfw-badge pfw-badge-secondary">4 file</span>
                </div>

            </div>

        </section>

    </div>

</div>

<div class="row g-3 mb-3">

    <div class="col-6 col-xl-3">
        <div class="pfw-kpi-card">
            <div class="pfw-kpi-label">Totale costi</div>
