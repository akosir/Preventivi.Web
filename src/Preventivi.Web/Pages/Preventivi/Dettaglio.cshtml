                    <td>
                        <span class="pfw-badge pfw-badge-secondary">Trasporto</span>
                    </td>
                    <td>Trasporto dedicato</td>
                    <td class="text-end">1</td>
                    <td class="text-end">€ 450,00</td>
                    <td class="text-end">€ 650,00</td>
                    <td class="text-end">30,77%</td>
                    <td class="text-end">
                        <a href="#" class="pfw-action-link">Apri</a>
                    </td>
                </tr>

                <tr>
                    <td>30</td>
                    <td>
                        <span class="pfw-badge pfw-badge-warning">Attrezzaggio</span>
                    </td>
                    <td>Attrezzaggio iniziale</td>
