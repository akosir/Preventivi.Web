@page
@model global::Preventivi.Web.Pages.Preventivi.Riga.LavorazioniModel

@{
    var modo = Request.Query["modo"].ToString();
    var idPreventivo = Request.Query["idPreventivo"].ToString();
    var idRigaPreventivo = Request.Query["idRigaPreventivo"].ToString();
    var idComponente = Request.Query["idComponente"].ToString();
    var titolo = LavorazioniModel.IsNuovo(modo)
        ? "Nuova lavorazione"
        : LavorazioniModel.IsElimina(modo)
            ? "Elimina lavorazione"
            : "Dettaglio lavorazione";

    ViewData["Title"] = titolo;
}

<div class="workspace-page">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="/Preventivi/Riga/Componenti"
               asp-route-modo="dettaglio"
               asp-route-idPreventivo="@idPreventivo"
               asp-route-idRigaPreventivo="@idRigaPreventivo"
               asp-route-id="@idComponente">
                Componente
            </a>
            <span>/</span>
            <span>@titolo</span>
        </div>

        <h1 class="workspace-title">@titolo</h1>
    </div>

    <section class="pfw-panel">
        <div class="p-3">
            @if (LavorazioniModel.IsNuovo(modo))
            {
                <form method="get"
                      class="pfw-panel mb-3">
                    <div class="p-3">
                        <input type="hidden" name="modo" value="nuovo" />
                        <input type="hidden" name="idPreventivo" value="@idPreventivo" />
                        <input type="hidden" name="idRigaPreventivo" value="@idRigaPreventivo" />
                        <input type="hidden" name="idComponente" value="@idComponente" />

                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="Origine">Origine lavorazione</label>
                                <select class="form-select" id="Origine" name="Origine">
                                    <option value="@LavorazioniModel.OrigineLibero"
                                            selected="@(Model.Origine == LavorazioniModel.OrigineLibero)">
                                        Libera
                                    </option>
                                    <option value="@LavorazioniModel.OrigineAnagrafica"
                                            selected="@(Model.Origine == LavorazioniModel.OrigineAnagrafica)">
                                        Da anagrafica lavorazione
                                    </option>
                                    <option value="@LavorazioniModel.OrigineDistinta"
                                            selected="@(Model.Origine == LavorazioniModel.OrigineDistinta)">
                                        Da distinta componente
                                    </option>
                                </select>
                            </div>

                            @if (Model.Origine == LavorazioniModel.OrigineDistinta)
                            {
                                <div class="col-12 col-md-7">
                                    <label class="form-label" for="IdDistintaLavorazioneSelezionata">Lavorazione da distinta</label>
                                    <select class="form-select"
                                            id="IdDistintaLavorazioneSelezionata"
                                            name="IdDistintaLavorazioneSelezionata">
                                        <option value="">Seleziona...</option>
                                        @foreach (var lavorazione in Model.LavorazioniDistinta)
                                        {
                                            <option value="@lavorazione.IdDistintaLavorazione"
                                                    selected="@(Model.IdDistintaLavorazioneSelezionata == lavorazione.IdDistintaLavorazione)">
                                                @lavorazione.Display
                                            </option>
                                        }
                                    </select>
                                </div>
                            }
                            else if (Model.Origine == LavorazioniModel.OrigineAnagrafica)
                            {
                                <div class="col-12 col-md-4">
                                    <label class="form-label" for="RicercaLavorazione">Cerca lavorazione</label>
                                    <input class="form-control"
                                           id="RicercaLavorazione"
                                           name="RicercaLavorazione"
                                           value="@Model.RicercaLavorazione"
                                           placeholder="Codice o descrizione..." />
                                </div>
                                <div class="col-12 col-md-3">
                                    <label class="form-label" for="IdLavorazioneSelezionata">Lavorazione</label>
                                    <select class="form-select"
                                            id="IdLavorazioneSelezionata"
                                            name="IdLavorazioneSelezionata">
                                        <option value="">Seleziona...</option>
                                        @foreach (var lavorazione in Model.LavorazioniAnagrafica)
                                        {
                                            <option value="@lavorazione.IdLavorazione"
                                                    selected="@(Model.IdLavorazioneSelezionata == lavorazione.IdLavorazione)">
                                                @lavorazione.Display
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-12 col-md-2">
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    Aggiorna
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <form method="post"
                      asp-route-modo="nuovo"
                      asp-route-idPreventivo="@idPreventivo"
                      asp-route-idRigaPreventivo="@idRigaPreventivo"
                      asp-route-idComponente="@idComponente">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Origine" />
                    <input type="hidden" asp-for="RicercaLavorazione" />
                    <input type="hidden" asp-for="IdDistintaLavorazioneSelezionata" />
                    <input type="hidden" asp-for="IdLavorazioneSelezionata" />
                    <input type="hidden" asp-for="NuovaLavorazione.IdNodoDistinta" />
                    <input type="hidden" asp-for="NuovaLavorazione.IdLavorazione" />

                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.Sequenza" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.Sequenza" class="form-control text-end" />
                        </div>
                        <div class="col-12">
                            <label asp-for="NuovaLavorazione.DescrizioneLavorazione" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.DescrizioneLavorazione"
                                   class="form-control"
                                   readonly="@(Model.Origine != LavorazioniModel.OrigineLibero)" />
                            <span asp-validation-for="NuovaLavorazione.DescrizioneLavorazione" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.TempoSetupMin" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.TempoSetupMin" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.TempoPezzoMin" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.TempoPezzoMin" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.Quantita" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.Quantita" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.CostoOrario" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.CostoOrario" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.CostoFisso" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.CostoFisso" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="NuovaLavorazione.IdFornitoreSuggerito" class="form-label"></label>
                            <input asp-for="NuovaLavorazione.IdFornitoreSuggerito" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="NuovaLavorazione.DaAcquistareEsterno" class="form-check-input" />
                                <label asp-for="NuovaLavorazione.DaAcquistareEsterno" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salva</button>
                        <a class="btn btn-outline-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Annulla
                        </a>
                    </div>
                </form>
            }
            else if (Model.Lavorazione is not null)
            {
                <dl class="row mb-0">
                    <dt class="col-sm-3">Sequenza</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.Sequenza</dd>
                    <dt class="col-sm-3">DescrizioneLavorazione</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.DescrizioneLavorazione</dd>
                    <dt class="col-sm-3">TempoSetupMin</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.TempoSetupMin.ToString("N2")</dd>
                    <dt class="col-sm-3">TempoPezzoMin</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.TempoPezzoMin.ToString("N2")</dd>
                    <dt class="col-sm-3">Quantita</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.Quantita.ToString("N2")</dd>
                    <dt class="col-sm-3">TempoTotaleMin</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.TempoTotaleMin.ToString("N2")</dd>
                    <dt class="col-sm-3">CostoOrario</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.CostoOrario.ToString("C2")</dd>
                    <dt class="col-sm-3">CostoFisso</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.CostoFisso.ToString("C2")</dd>
                    <dt class="col-sm-3">CostoTotale</dt>
                    <dd class="col-sm-9">@Model.Lavorazione.CostoTotale.ToString("C2")</dd>
                    <dt class="col-sm-3">Esterno</dt>
                    <dd class="col-sm-9">@(Model.Lavorazione.DaAcquistareEsterno ? "Si" : "No")</dd>
                </dl>

                @if (LavorazioniModel.IsElimina(modo))
                {
                    <form method="post"
                          class="mt-3"
                          asp-route-modo="elimina"
                          asp-route-idPreventivo="@idPreventivo"
                          asp-route-idRigaPreventivo="@idRigaPreventivo"
                          asp-route-idComponente="@idComponente"
                          asp-route-id="@Model.Lavorazione.IdRigaLavPrev">
                        <button type="submit" class="btn btn-danger">Conferma eliminazione</button>
                        <a class="btn btn-outline-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Annulla
                        </a>
                    </form>
                }
                else
                {
                    var returnUrl = LavorazioniModel.GetLavorazioneReturnUrl(
                        int.Parse(idPreventivo),
                        int.Parse(idRigaPreventivo),
                        int.Parse(idComponente),
                        Model.Lavorazione.IdRigaLavPrev);

                    <section class="pfw-panel mt-4">
                        <div class="pfw-panel-header">
                            <div>
                                <h2 class="pfw-panel-title">Allegati lavorazione</h2>
                            </div>
                        </div>
                        <div class="p-3">
                            @await Html.PartialAsync(
                                "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                                {
                                    TestoNuovo = "Nuovo allegato",
                                    UrlNuovo = $"/Allegati/Nuovo?Entita=PreventiviRigheLavorazioni&IdEntita={Model.Lavorazione.IdRigaLavPrev}&ReturnUrl={Uri.EscapeDataString(returnUrl)}"
                                })

                            @if (Model.Allegati.Allegati.Count == 0)
                            {
                                <div class="workspace-placeholder">
                                    <div class="workspace-placeholder-title">Nessun allegato presente</div>
                                </div>
                            }
                            else
                            {
                                @await Html.PartialAsync(
                                    "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                                    Model.Allegati)
                            }
                        </div>
                    </section>

                    <div class="mt-3">
                        <a class="btn btn-outline-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Torna al componente
                        </a>
                    </div>
                }
            }
        </div>
    </section>
</div>
