@page
@model global::Preventivi.Web.Pages.Preventivi.Riga.MaterialiModel

@{
    var modo = Request.Query["modo"].ToString();
    var idPreventivo = Request.Query["idPreventivo"].ToString();
    var idRigaPreventivo = Request.Query["idRigaPreventivo"].ToString();
    var idComponente = Request.Query["idComponente"].ToString();
    var titolo = MaterialiModel.IsNuovo(modo)
        ? "Nuovo materiale"
        : MaterialiModel.IsElimina(modo)
            ? "Elimina materiale"
            : "Dettaglio materiale";

    ViewData["Title"] = titolo;
}

<div class="workspace-page preventivi-page preventivo-workspace">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="/Preventivi/Riga/Componenti"
               asp-route-modo="dettaglio"
               asp-route-idPreventivo="@idPreventivo"
               asp-route-idRigaPreventivo="@idRigaPreventivo"
               asp-route-id="@idComponente">
                Componente
            </a>
            <span>/</span>
            <span>@titolo</span>
        </div>

        <h1 class="workspace-title">@titolo</h1>
    </div>

    <section class="pfw-panel">
        <div class="p-3">
            @if (MaterialiModel.IsNuovo(modo))
            {
                <form method="get"
                      class="preventivi-origin-selector mb-3">
                    <div class="p-3">
                        <input type="hidden" name="modo" value="nuovo" />
                        <input type="hidden" name="idPreventivo" value="@idPreventivo" />
                        <input type="hidden" name="idRigaPreventivo" value="@idRigaPreventivo" />
                        <input type="hidden" name="idComponente" value="@idComponente" />

                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="Origine">Origine materiale</label>
                                <select class="form-select" id="Origine" name="Origine">
                                    <option value="@MaterialiModel.OrigineLibero"
                                            selected="@(Model.Origine == MaterialiModel.OrigineLibero)">
                                        Libero
                                    </option>
                                    <option value="@MaterialiModel.OrigineAnagrafica"
                                            selected="@(Model.Origine == MaterialiModel.OrigineAnagrafica)">
                                        Da anagrafica materiale
                                    </option>
                                    <option value="@MaterialiModel.OrigineDistinta"
                                            selected="@(Model.Origine == MaterialiModel.OrigineDistinta)">
                                        Da distinta componente
                                    </option>
                                </select>
                            </div>

                            @if (Model.Origine == MaterialiModel.OrigineDistinta)
                            {
                                <div class="col-12 col-md-7">
                                    <label class="form-label" for="IdDistintaMaterialeSelezionato">Materiale da distinta</label>
                                    <select class="form-select"
                                            id="IdDistintaMaterialeSelezionato"
                                            name="IdDistintaMaterialeSelezionato">
                                        <option value="">Seleziona...</option>
                                        @foreach (var materiale in Model.MaterialiDistinta)
                                        {
                                            <option value="@materiale.IdDistintaMateriale"
                                                    selected="@(Model.IdDistintaMaterialeSelezionato == materiale.IdDistintaMateriale)">
                                                @materiale.Display
                                            </option>
                                        }
                                    </select>
                                </div>
                            }
                            else if (Model.Origine == MaterialiModel.OrigineAnagrafica)
                            {
                                <div class="col-12 col-md-4">
                                    <label class="form-label" for="RicercaMateriale">Cerca materiale</label>
                                    <input class="form-control"
                                           id="RicercaMateriale"
                                           name="RicercaMateriale"
                                           value="@Model.RicercaMateriale"
                                           placeholder="Codice o descrizione..." />
                                </div>
                                <div class="col-12 col-md-3">
                                    <label class="form-label" for="IdMaterialeSelezionato">Materiale</label>
                                    <select class="form-select"
                                            id="IdMaterialeSelezionato"
                                            name="IdMaterialeSelezionato">
                                        <option value="">Seleziona...</option>
                                        @foreach (var materiale in Model.MaterialiAnagrafica)
                                        {
                                            <option value="@materiale.IdMateriale"
                                                    selected="@(Model.IdMaterialeSelezionato == materiale.IdMateriale)">
                                                @materiale.Display
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-12 col-md-2">
                                <button type="submit" class="pfw-btn pfw-btn-secondary w-100">
                                    Aggiorna
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <form method="post"
                      asp-route-modo="nuovo"
                      asp-route-idPreventivo="@idPreventivo"
                      asp-route-idRigaPreventivo="@idRigaPreventivo"
                      asp-route-idComponente="@idComponente">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Origine" />
                    <input type="hidden" asp-for="RicercaMateriale" />
                    <input type="hidden" asp-for="IdDistintaMaterialeSelezionato" />
                    <input type="hidden" asp-for="IdMaterialeSelezionato" />
                    <input type="hidden" asp-for="NuovoMateriale.IdNodoDistinta" />
                    <input type="hidden" asp-for="NuovoMateriale.IdMateriale" />

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="NuovoMateriale.UM" class="form-label"></label>
                            <input asp-for="NuovoMateriale.UM"
                                   class="form-control"
                                   readonly="@(Model.Origine != MaterialiModel.OrigineLibero)" />
                        </div>
                        <div class="col-12 pfw-field-required">
                            <label asp-for="NuovoMateriale.DescrizioneMateriale" class="form-label"></label>
                            <input asp-for="NuovoMateriale.DescrizioneMateriale"
                                   class="form-control"
                                   readonly="@(Model.Origine != MaterialiModel.OrigineLibero)" />
                            <span asp-validation-for="NuovoMateriale.DescrizioneMateriale" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="NuovoMateriale.TipoMateriale" class="form-label"></label>
                            <input asp-for="NuovoMateriale.TipoMateriale"
                                   class="form-control"
                                   readonly="@(Model.Origine != MaterialiModel.OrigineLibero)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="NuovoMateriale.Quantita" class="form-label"></label>
                            <input asp-for="NuovoMateriale.Quantita" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="NuovoMateriale.CostoUnitario" class="form-label"></label>
                            <input asp-for="NuovoMateriale.CostoUnitario" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="NuovoMateriale.IdFornitoreSuggerito" class="form-label"></label>
                            <input asp-for="NuovoMateriale.IdFornitoreSuggerito" class="form-control text-end" />
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="NuovoMateriale.DaAcquistare" class="form-check-input" />
                                <label asp-for="NuovoMateriale.DaAcquistare" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="preventivi-form-actions">
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Annulla
                        </a>
                        <button type="submit" class="pfw-btn pfw-btn-primary">Salva</button>
                    </div>
                </form>
            }
            else if (Model.Materiale is not null)
            {
                <dl class="preventivo-detail-list">
                    <div><dt>Descrizione</dt><dd>@Model.Materiale.DescrizioneMateriale</dd></div>
                    <div><dt>Tipo materiale</dt><dd>@Model.Materiale.TipoMateriale</dd></div>
                    <div><dt>Unità di misura</dt><dd>@Model.Materiale.UM</dd></div>
                    <div><dt>Quantità</dt><dd>@Model.Materiale.Quantita.ToString("N2")</dd></div>
                    <div><dt>Costo unitario</dt><dd>@Model.Materiale.CostoUnitario.ToString("C4")</dd></div>
                    <div><dt>Costo totale</dt><dd>@Model.Materiale.CostoTotale.ToString("C2")</dd></div>
                    <div><dt>Da acquistare</dt><dd>@(Model.Materiale.DaAcquistare ? "Sì" : "No")</dd></div>
                </dl>

                @if (MaterialiModel.IsElimina(modo))
                {
                    <form method="post"
                          class="mt-3"
                          asp-route-modo="elimina"
                          asp-route-idPreventivo="@idPreventivo"
                          asp-route-idRigaPreventivo="@idRigaPreventivo"
                          asp-route-idComponente="@idComponente"
                          asp-route-id="@Model.Materiale.IdRigaMatPrev">
                        <button type="submit" class="pfw-btn pfw-btn-danger">Conferma eliminazione</button>
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Annulla
                        </a>
                    </form>
                }
                else
                {
                    var returnUrl = MaterialiModel.GetMaterialeReturnUrl(
                        int.Parse(idPreventivo),
                        int.Parse(idRigaPreventivo),
                        int.Parse(idComponente),
                        Model.Materiale.IdRigaMatPrev);

                    <section class="pfw-panel mt-4">
                        <div class="pfw-panel-header">
                            <div>
                                <h2 class="pfw-panel-title">Allegati materiale</h2>
                            </div>
                        </div>
                        <div class="p-3">
                            @await Html.PartialAsync(
                                "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                                {
                                    TestoNuovo = "Nuovo allegato",
                                    UrlNuovo = $"/Allegati/Nuovo?Entita=PreventiviRigheMateriali&IdEntita={Model.Materiale.IdRigaMatPrev}&ReturnUrl={Uri.EscapeDataString(returnUrl)}"
                                })

                            @if (Model.Allegati.Allegati.Count == 0)
                            {
                                <div class="workspace-placeholder">
                                    <div class="workspace-placeholder-title">Nessun allegato presente</div>
                                </div>
                            }
                            else
                            {
                                @await Html.PartialAsync(
                                    "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                                    Model.Allegati)
                            }
                        </div>
                    </section>

                    <div class="mt-3">
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Componenti"
                           asp-route-modo="dettaglio"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                           asp-route-id="@idComponente">
                            Torna al componente
                        </a>
                    </div>
                }
            }
        </div>
    </section>
</div>
