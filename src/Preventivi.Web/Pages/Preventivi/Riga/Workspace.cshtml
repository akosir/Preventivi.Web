@page
@model global::Preventivi.Web.Pages.Preventivi.Riga.WorkspaceModel

@{
    ViewData["Title"] = $"Riga {Model.Riga!.RigaNr} - Preventivo {Model.Preventivo!.NumeroCompleto}";
}

<div class="workspace-page">

    <div class="workspace-header">

        <div class="workspace-breadcrumb">
            <a asp-page="/Index">Dashboard</a>
            <span>/</span>
            <a asp-page="/Preventivi/Index">Preventivi</a>
            <span>/</span>
            <a asp-page="/Preventivi/Dettaglio"
               asp-route-id="@Model.Preventivo.IdPreventivo">
                @Model.Preventivo.NumeroCompleto
            </a>
            <span>/</span>
            <span>Riga @Model.Riga.RigaNr</span>
        </div>

        <div class="workspace-top">
            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h1 class="workspace-title mb-0">
                        Riga preventivo @Model.Riga.RigaNr
                    </h1>

                    <span class="pfw-badge pfw-badge-secondary">
                        @Model.Riga.TipoRiga
                    </span>
                </div>

                <div class="workspace-subtitle">
                    Preventivo @Model.Preventivo.NumeroCompleto
                    <span class="mx-1">•</span>
                    @Model.Preventivo.Cliente
                </div>
            </div>
        </div>

    </div>

    <section class="pfw-panel mb-3">

        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dettaglio riga preventivo</h2>
                <div class="pfw-panel-subtitle">
                    Dati della riga e valori calcolati
                </div>
            </div>
        </div>

        <div class="p-3">

            <div class="row g-3 align-items-start">

                <div class="col-12 col-lg-4">
                    <div class="row g-2">

                        <div class="col-12 col-md-4 col-lg-12">
                            <label class="form-label">RigaNr</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.RigaNr"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-4 col-lg-12">
                            <label class="form-label">IdArticolo</label>
                            <input class="form-control"
                                   value="@Model.Riga.IdArticolo"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-4 col-lg-12">
                            <label class="form-label">IdModelloCiclo</label>
                            <input class="form-control"
                                   value="@Model.Riga.IdModelloCiclo"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">DescrizioneVoce</label>
                            <textarea class="form-control"
                                      rows="4"
                                      readonly>@Model.Riga.DescrizioneVoce</textarea>
                        </div>

                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="row g-2">

                        <div class="col-12">
                            <label class="form-label">Quantità</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.Quantita.ToString("N2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Prezzo unit. Vendita</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.PrezzoUnitarioVendita.ToString("N4")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Prezzo Manuale cad.</label>
                            <input type="checkbox"
                                   checked="@Model.Riga.PrezzoManuale"
                                   disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Markup Libero</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.MarkupPerc.ToString("N2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Costo Libero cad</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.CostoUnitarioLibero?.ToString("N4")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">TipoRiga</label>
                            <input class="form-control"
                                   value="@Model.Riga.TipoRiga"
                                   readonly />
                        </div>

                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="row g-2">

                        <div class="col-12">
                            <label class="form-label">Note</label>
                            <textarea class="form-control"
                                      rows="4"
                                      readonly>@Model.Riga.Note</textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">TotaleVendita</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Riga.TotaleVendita.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">TotaleCosti</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Riga.TotaleCosti.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">MargineValore</label>
                            <input class="form-control text-end fw-semibold"
                                   value="@Model.Riga.MargineValore.ToString("C2")"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Margine %</label>
                            <input class="form-control text-end"
                                   value="@Model.Riga.MarginePerc.ToString("N2")"
                                   readonly />
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </section>

    <section class="pfw-panel">

        <div class="workspace-tabs">

            <a href="#componenti-riga"
               class="workspace-tab active text-decoration-none">
                Componenti
            </a>

            <a href="#materiali-riga"
               class="workspace-tab text-decoration-none">
                Materiali
            </a>

            <a href="#lavorazioni-riga"
               class="workspace-tab text-decoration-none">
                Lavorazioni
            </a>

        </div>

        <div class="workspace-tab-content">

            <div id="componenti-riga"
                 class="workspace-righe-toolbar">
                <div>
                    <strong>Componenti</strong>
                    <span class="workspace-righe-count">
                        @Model.Componenti.Count righe
                    </span>
                </div>
                <a class="btn btn-sm btn-primary"
                   asp-page="/Preventivi/Riga/Componenti"
                   asp-route-modo="nuovo"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                    Nuovo componente
                </a>
            </div>

            @if (Model.Componenti.Count == 0)
            {
                <div class="workspace-placeholder">
                    <div class="workspace-placeholder-title">
                        Nessun componente presente
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ordine</th>
                                <th>IdNodo</th>
                                <th>IdPadre</th>
                                <th>DescrizioneNodo</th>
                                <th class="text-end">Livello</th>
                                <th class="text-end">QuantitaBase</th>
                                <th class="text-end">QuantitaCalcolata</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var componente in Model.Componenti)
                            {
                                <tr>
                                    <td>@componente.OrdineVisualizzazione</td>
                                    <td>@componente.IdNodoDistinta</td>
                                    <td>@componente.IdNodoPadre</td>
                                    <td>@componente.DescrizioneNodo</td>
                                    <td class="text-end">@componente.Livello</td>
                                    <td class="text-end">@componente.QuantitaBase.ToString("N2")</td>
                                    <td class="text-end">@componente.QuantitaCalcolata.ToString("N2")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="/Preventivi/Riga/Componenti"
                                           asp-route-modo="dettaglio"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@componente.IdRigaCompPrev">
                                            Apri
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-page="/Preventivi/Riga/Componenti"
                                           asp-route-modo="elimina"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@componente.IdRigaCompPrev">
                                            Elimina
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr id="materiali-riga"
                class="my-4" />

            <div class="workspace-righe-toolbar">
                <div>
                    <strong>Materiali</strong>
                    <span class="workspace-righe-count">
                        @Model.Materiali.Count righe
                    </span>
                </div>
                <a class="btn btn-sm btn-primary"
                   asp-page="/Preventivi/Riga/Materiali"
                   asp-route-modo="nuovo"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                    Nuovo materiale
                </a>
            </div>

            @if (Model.Materiali.Count == 0)
            {
                <div class="workspace-placeholder">
                    <div class="workspace-placeholder-title">
                        Nessun materiale presente
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>DescrizioneMateriale</th>
                                <th>Tipo</th>
                                <th>UM</th>
                                <th class="text-end">Quantita</th>
                                <th class="text-end">CostoUnitario</th>
                                <th class="text-end">CostoTotale</th>
                                <th>Da acquistare</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var materiale in Model.Materiali)
                            {
                                <tr>
                                    <td>@materiale.DescrizioneMateriale</td>
                                    <td>@materiale.TipoMateriale</td>
                                    <td>@materiale.UM</td>
                                    <td class="text-end">@materiale.Quantita.ToString("N2")</td>
                                    <td class="text-end">@materiale.CostoUnitario.ToString("C4")</td>
                                    <td class="text-end">@materiale.CostoTotale.ToString("C2")</td>
                                    <td>
                                        <input type="checkbox"
                                               checked="@materiale.DaAcquistare"
                                               disabled />
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="/Preventivi/Riga/Materiali"
                                           asp-route-modo="dettaglio"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@materiale.IdRigaMatPrev">
                                            Apri
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-page="/Preventivi/Riga/Materiali"
                                           asp-route-modo="elimina"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@materiale.IdRigaMatPrev">
                                            Elimina
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr id="lavorazioni-riga"
                class="my-4" />

            <div class="workspace-righe-toolbar">
                <div>
                    <strong>Lavorazioni</strong>
                    <span class="workspace-righe-count">
                        @Model.Lavorazioni.Count righe
                    </span>
                </div>
                <a class="btn btn-sm btn-primary"
                   asp-page="/Preventivi/Riga/Lavorazioni"
                   asp-route-modo="nuovo"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                    Nuova lavorazione
                </a>
            </div>

            @if (Model.Lavorazioni.Count == 0)
            {
                <div class="workspace-placeholder">
                    <div class="workspace-placeholder-title">
                        Nessuna lavorazione presente
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-end">Sequenza</th>
                                <th>DescrizioneLavorazione</th>
                                <th class="text-end">Setup</th>
                                <th class="text-end">Tempo pezzo</th>
                                <th class="text-end">Quantita</th>
                                <th class="text-end">Tempo totale</th>
                                <th class="text-end">Costo orario</th>
                                <th class="text-end">Costo fisso</th>
                                <th class="text-end">Costo totale</th>
                                <th>Esterno</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lavorazione in Model.Lavorazioni)
                            {
                                <tr>
                                    <td class="text-end">@lavorazione.Sequenza</td>
                                    <td>@lavorazione.DescrizioneLavorazione</td>
                                    <td class="text-end">@lavorazione.TempoSetupMin.ToString("N2")</td>
                                    <td class="text-end">@lavorazione.TempoPezzoMin.ToString("N2")</td>
                                    <td class="text-end">@lavorazione.Quantita.ToString("N2")</td>
                                    <td class="text-end">@lavorazione.TempoTotaleMin.ToString("N2")</td>
                                    <td class="text-end">@lavorazione.CostoOrario.ToString("C2")</td>
                                    <td class="text-end">@lavorazione.CostoFisso.ToString("C2")</td>
                                    <td class="text-end">@lavorazione.CostoTotale.ToString("C2")</td>
                                    <td>
                                        <input type="checkbox"
                                               checked="@lavorazione.DaAcquistareEsterno"
                                               disabled />
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="/Preventivi/Riga/Lavorazioni"
                                           asp-route-modo="dettaglio"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@lavorazione.IdRigaLavPrev">
                                            Apri
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-page="/Preventivi/Riga/Lavorazioni"
                                           asp-route-modo="elimina"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@lavorazione.IdRigaLavPrev">
                                            Elimina
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </section>

</div>
