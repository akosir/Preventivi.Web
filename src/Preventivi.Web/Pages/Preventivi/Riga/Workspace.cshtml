@page
@model global::Preventivi.Web.Pages.Preventivi.Riga.WorkspaceModel

@{
    ViewData["Title"] = $"Riga {Model.Riga!.RigaNr} - Preventivo {Model.Preventivo!.NumeroCompleto}";
}

<div class="workspace-page preventivi-page preventivo-workspace">

    <div class="workspace-header">

        <div class="workspace-breadcrumb">
            <a asp-page="/Index">Dashboard</a>
            <span>/</span>
            <a asp-page="/Preventivi/Index">Preventivi</a>
            <span>/</span>
            <a asp-page="/Preventivi/Dettaglio"
               asp-route-id="@Model.Preventivo.IdPreventivo">
                @Model.Preventivo.NumeroCompleto
            </a>
            <span>/</span>
            <span>Riga @Model.Riga.RigaNr</span>
        </div>

        <div class="workspace-top">
            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h1 class="workspace-title mb-0">
                        Riga preventivo @Model.Riga.RigaNr
                    </h1>

                    <span class="pfw-badge pfw-badge-secondary">
                        @Model.Riga.TipoRiga
                    </span>
                </div>

                <div class="workspace-subtitle">
                    Preventivo @Model.Preventivo.NumeroCompleto
                    <span class="mx-1">•</span>
                    @Model.Preventivo.Cliente
                </div>
            </div>
            <div class="preventivi-actions">
                <a class="pfw-btn pfw-btn-primary"
                   asp-page="/Preventivi/Riga/Modifica"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                    Modifica
                </a>
                <a class="pfw-btn pfw-btn-danger"
                   asp-page="/Preventivi/Riga/Elimina"
                   asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                   asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                    Elimina
                </a>
            </div>
        </div>

    </div>

    <section class="pfw-panel">

        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dettaglio riga preventivo</h2>
                <div class="pfw-panel-subtitle">
                    Dati della riga e valori calcolati
                </div>
            </div>
        </div>

        <div class="preventivo-summary-grid">
            <div class="preventivo-data-grid">
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Numero riga</div>
                    <div class="preventivo-data-value">@Model.Riga.RigaNr</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Tipo riga</div>
                    <div class="preventivo-data-value">@Model.Riga.TipoRiga</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Articolo</div>
                    <div class="preventivo-data-value">@(Model.Riga.IdArticolo?.ToString() ?? "Non associato")</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Modello ciclo</div>
                    <div class="preventivo-data-value">@(Model.Riga.IdModelloCiclo?.ToString() ?? "Non associato")</div>
                </div>
                <div class="preventivo-data-item preventivo-data-item-wide">
                    <div class="preventivo-data-label">Descrizione</div>
                    <div class="preventivo-data-value preventivo-data-value-multiline">@Model.Riga.DescrizioneVoce</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Quantità</div>
                    <div class="preventivo-data-value justify-content-end">@Model.Riga.Quantita.ToString("N2")</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Prezzo unitario vendita</div>
                    <div class="preventivo-data-value justify-content-end">@Model.Riga.PrezzoUnitarioVendita.ToString("C4")</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Markup libero</div>
                    <div class="preventivo-data-value justify-content-end">@Model.Riga.MarkupPerc.ToString("N2") %</div>
                </div>
                <div class="preventivo-data-item">
                    <div class="preventivo-data-label">Costo libero unitario</div>
                    <div class="preventivo-data-value justify-content-end">@(Model.Riga.CostoUnitarioLibero?.ToString("C4") ?? "Non previsto")</div>
                </div>
                <div class="preventivo-data-item preventivo-data-item-wide">
                    <div class="preventivo-data-label">Note</div>
                    <div class="preventivo-data-value preventivo-data-value-multiline">@(string.IsNullOrWhiteSpace(Model.Riga.Note) ? "Nessuna nota" : Model.Riga.Note)</div>
                </div>
            </div>

            <div class="preventivo-metrics" aria-label="Riepilogo economico riga">
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Totale costi</span>
                    <strong class="preventivo-metric-value">@Model.Riga.TotaleCosti.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric preventivo-metric-primary">
                    <span class="preventivo-metric-label">Totale vendita</span>
                    <strong class="preventivo-metric-value">@Model.Riga.TotaleVendita.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Margine valore</span>
                    <strong class="preventivo-metric-value">@Model.Riga.MargineValore.ToString("C2")</strong>
                </div>
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Margine percentuale</span>
                    <strong class="preventivo-metric-value">@Model.Riga.MarginePerc.ToString("N2") %</strong>
                </div>
                <div class="preventivo-metric">
                    <span class="preventivo-metric-label">Prezzo manuale</span>
                    <strong class="preventivo-metric-value">@(Model.Riga.PrezzoManuale ? "Sì" : "No")</strong>
                </div>
            </div>
        </div>

    </section>

    <section class="pfw-panel">

        <div class="workspace-tabs">

            <a href="#componenti-riga"
               class="workspace-tab active text-decoration-none">
                Componenti
            </a>

        </div>

        <div class="workspace-tab-content">

            <div id="componenti-riga"
                 class="preventivo-section-toolbar">
                <div>
                    <span class="preventivo-section-title">Componenti</span>
                    <span class="preventivo-section-count">
                        @Model.Componenti.Count righe
                    </span>
                </div>
                @if (!Model.RigaLibera)
                {
                    <a class="pfw-btn pfw-btn-primary"
                       asp-page="/Preventivi/Riga/Componenti"
                       asp-route-modo="nuovo"
                       asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                       asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo">
                        Nuovo componente
                    </a>
                }
            </div>

            @if (Model.RigaLibera)
            {
                <div class="alert alert-info mb-3" role="status">
                    Le righe libere non prevedono componenti, materiali o lavorazioni.
                </div>
            }

            @if (Model.Componenti.Count == 0)
            {
                <div class="workspace-placeholder">
                    <div class="workspace-placeholder-title">
                        Nessun componente presente
                    </div>
                </div>
            }
            else
            {
                <div class="preventivi-table-wrap">
                    <table class="table pfw-table preventivi-table align-middle">
                        <thead>
                            <tr>
                                <th>Ordine</th>
                                <th>Nodo distinta</th>
                                <th>Nodo padre</th>
                                <th>Descrizione</th>
                                <th class="text-end">Livello</th>
                                <th class="text-end">Quantità base</th>
                                <th class="text-end">Quantità calcolata</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var componente in Model.Componenti)
                            {
                                <tr>
                                    <td>@componente.OrdineVisualizzazione</td>
                                    <td>@componente.IdNodoDistinta</td>
                                    <td>@componente.IdNodoPadre</td>
                                    <td class="fw-semibold">@componente.DescrizioneNodo</td>
                                    <td class="text-end">@componente.Livello</td>
                                    <td class="text-end">@componente.QuantitaBase.ToString("N2")</td>
                                    <td class="text-end">@componente.QuantitaCalcolata.ToString("N2")</td>
                                    <td class="text-end">
                                        <div class="preventivi-actions">
                                        <a class="pfw-btn pfw-btn-secondary pfw-btn-compact"
                                           asp-page="/Preventivi/Riga/Componenti"
                                           asp-route-modo="dettaglio"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@componente.IdRigaCompPrev">
                                            Apri
                                        </a>
                                        <a class="pfw-btn pfw-btn-secondary pfw-btn-compact"
                                           asp-page="/Preventivi/Riga/ComponenteModifica"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@componente.IdRigaCompPrev">
                                            Modifica
                                        </a>
                                        <a class="pfw-btn pfw-btn-danger pfw-btn-compact"
                                           asp-page="/Preventivi/Riga/Componenti"
                                           asp-route-modo="elimina"
                                           asp-route-idPreventivo="@Model.Preventivo.IdPreventivo"
                                           asp-route-idRigaPreventivo="@Model.Riga.IdRigaPreventivo"
                                           asp-route-id="@componente.IdRigaCompPrev">
                                            Elimina
                                        </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </section>

</div>
