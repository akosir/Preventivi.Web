@page
@model global::Preventivi.Web.Pages.Preventivi.Riga.ComponentiModel

@{
    var modo = Model.EliminazioneRichiesta ? "elimina" : Request.Query["modo"].ToString();
    var idPreventivo = Model.EliminazioneRichiesta
        ? Model.IdPreventivoEliminazione?.ToString()
        : Request.Query["idPreventivo"].ToString();
    var idRigaPreventivo = Model.EliminazioneRichiesta
        ? Model.IdRigaEliminazione?.ToString()
        : Request.Query["idRigaPreventivo"].ToString();
    var titolo = ComponentiModel.IsNuovo(modo)
        ? "Nuovo componente"
        : ComponentiModel.IsElimina(modo)
            ? "Elimina componente"
            : "Dettaglio componente";

    ViewData["Title"] = titolo;
}

<div class="workspace-page preventivi-page preventivo-workspace">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            @if (!Model.EliminazioneRichiesta || Model.IdRigaEliminazione.HasValue)
            {
                <a asp-page="/Preventivi/Riga/Workspace"
                   asp-route-idPreventivo="@idPreventivo"
                   asp-route-idRigaPreventivo="@idRigaPreventivo">
                    Riga preventivo
                </a>
                <span>/</span>
            }
            <span>@titolo</span>
        </div>

        <h1 class="workspace-title">@titolo</h1>
    </div>

    <section class="pfw-panel">
        <div class="p-3">
            @if (Model.EliminazioneRichiesta)
            {
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            }

            @if (ComponentiModel.IsNuovo(modo))
            {
                <form method="get"
                      class="preventivi-origin-selector mb-3">
                    <div class="p-3">
                        <input type="hidden" name="modo" value="nuovo" />
                        <input type="hidden" name="idPreventivo" value="@idPreventivo" />
                        <input type="hidden" name="idRigaPreventivo" value="@idRigaPreventivo" />

                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3 pfw-field-required">
                                <label class="form-label" for="Origine">Origine componente</label>
                                <select class="form-select" id="Origine" name="Origine">
                                    <option value="@ComponentiModel.OrigineLibero"
                                            selected="@(Model.Origine == ComponentiModel.OrigineLibero)">
                                        Libero
                                    </option>
                                    <option value="@ComponentiModel.OrigineArticolo"
                                            selected="@(Model.Origine == ComponentiModel.OrigineArticolo)">
                                        Da anagrafica articolo
                                    </option>
                                    <option value="@ComponentiModel.OrigineDistinta"
                                            selected="@(Model.Origine == ComponentiModel.OrigineDistinta)">
                                        Da distinta esistente
                                    </option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" for="RicercaArticolo">Cerca articolo/distinta</label>
                                <input class="form-control"
                                       id="RicercaArticolo"
                                       name="RicercaArticolo"
                                       value="@Model.RicercaArticolo"
                                       placeholder="Codice o descrizione..." />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label" for="IdArticoloSelezionato">Articolo</label>
                                <select class="form-select"
                                        id="IdArticoloSelezionato"
                                        name="IdArticoloSelezionato">
                                    <option value="">Seleziona...</option>
                                    @foreach (var articolo in Model.Articoli)
                                    {
                                        <option value="@articolo.IdArticolo"
                                                selected="@(Model.IdArticoloSelezionato == articolo.IdArticolo)">
                                            @articolo.Display
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-2">
                                <button type="submit" class="pfw-btn pfw-btn-secondary w-100">
                                    Aggiorna
                                </button>
                            </div>

                            @if (Model.Origine == ComponentiModel.OrigineDistinta &&
                                 Model.NodiDistinta.Count > 0)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="IdNodoDistintaSelezionato">Nodo distinta</label>
                                    <select class="form-select"
                                            id="IdNodoDistintaSelezionato"
                                            name="IdNodoDistintaSelezionato">
                                        <option value="">Seleziona nodo...</option>
                                        @foreach (var nodo in Model.NodiDistinta)
                                        {
                                            <option value="@nodo.IdNodoDistinta"
                                                    selected="@(Model.IdNodoDistintaSelezionato == nodo.IdNodoDistinta)">
                                                @nodo.Display
                                            </option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                </form>

                <form method="post"
                      asp-route-modo="nuovo"
                      asp-route-idPreventivo="@idPreventivo"
                      asp-route-idRigaPreventivo="@idRigaPreventivo">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Origine" />
                    <input type="hidden" asp-for="RicercaArticolo" />
                    <input type="hidden" asp-for="IdArticoloSelezionato" />
                    <input type="hidden" asp-for="IdNodoDistintaSelezionato" />
                    <input type="hidden" asp-for="NuovoComponente.IdNodoDistinta" />
                    <input type="hidden" asp-for="NuovoComponente.IdNodoPadre" />

                    <div class="row g-3">
                        <div class="col-12 pfw-field-required">
                            <label asp-for="NuovoComponente.DescrizioneNodo" class="form-label">
                                Descrizione componente
                            </label>
                            <input asp-for="NuovoComponente.DescrizioneNodo"
                                   class="form-control"
                                   readonly="@(Model.Origine == ComponentiModel.OrigineDistinta)" />
                            <span asp-validation-for="NuovoComponente.DescrizioneNodo" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 pfw-field-required">
                            <label asp-for="NuovoComponente.QuantitaBase" class="form-label">
                                Quantità base
                            </label>
                            <input asp-for="NuovoComponente.QuantitaBase" class="form-control text-end" />
                            <span asp-validation-for="NuovoComponente.QuantitaBase" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NuovoComponente.IdRigaCompPrevPadre" class="form-label">
                                Componente padre
                            </label>
                            <select asp-for="NuovoComponente.IdRigaCompPrevPadre" class="form-select">
                                <option value="">Nessun padre (componente radice)</option>
                                @foreach (var componente in Model.ComponentiDisponibili)
                                {
                                    <option value="@componente.IdRigaCompPrev">
                                        @componente.DescrizioneNodo
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="NuovoComponente.IdRigaCompPrevPadre" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NuovoComponente.Livello" class="form-label">
                                Livello
                            </label>
                            <input asp-for="NuovoComponente.Livello"
                                   class="form-control text-end"
                                   readonly="@(Model.Origine == ComponentiModel.OrigineDistinta)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NuovoComponente.OrdineVisualizzazione" class="form-label">
                                Ordine visualizzazione
                            </label>
                            <input asp-for="NuovoComponente.OrdineVisualizzazione" class="form-control text-end" />
                        </div>

                        @if (Model.Origine == ComponentiModel.OrigineDistinta &&
                             Model.NodoDistintaSelezionato is not null)
                        {
                            <div class="col-12">
                                <div class="alert alert-info mb-0">
                                    Nodo distinta selezionato:
                                    <strong>@Model.NodoDistintaSelezionato.Display</strong>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="preventivi-form-actions">
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Workspace"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo">
                            Annulla
                        </a>
                        <button type="submit" class="pfw-btn pfw-btn-primary">Salva</button>
                    </div>
                </form>
            }
            else if (Model.Componente is not null)
            {
                var returnUrl = Model.Allegati.ReturnUrl ?? string.Empty;

                <dl class="preventivo-detail-list">
                    <div><dt>Origine</dt><dd>@Model.Componente.TipoOrigineComponente</dd></div>
                    <div><dt>Descrizione</dt><dd>@Model.Componente.DescrizioneNodo</dd></div>
                    <div><dt>Componente padre</dt><dd>@(Model.Componente.IdRigaCompPrevPadre?.ToString() ?? "Componente radice")</dd></div>
                    <div><dt>Articolo origine</dt><dd>@(Model.Componente.IdArticoloOrigine?.ToString() ?? "Non associato")</dd></div>
                    <div><dt>Ordine visualizzazione</dt><dd>@Model.Componente.OrdineVisualizzazione</dd></div>
                    <div><dt>Nodo distinta</dt><dd>@(Model.Componente.IdNodoDistinta?.ToString() ?? "Non associato")</dd></div>
                    <div><dt>Nodo padre distinta</dt><dd>@(Model.Componente.IdNodoPadre?.ToString() ?? "Non associato")</dd></div>
                    <div><dt>Livello</dt><dd>@Model.Componente.Livello</dd></div>
                    <div><dt>Quantità base</dt><dd>@Model.Componente.QuantitaBase.ToString("N2")</dd></div>
                    <div><dt>Quantità calcolata</dt><dd>@Model.Componente.QuantitaCalcolata.ToString("N2")</dd></div>
                </dl>

                @if (ComponentiModel.IsElimina(modo))
                {
                    <form method="post"
                          class="mt-3"
                          asp-route-modo="elimina"
                          asp-route-idPreventivo="@idPreventivo"
                          asp-route-idRigaPreventivo="@idRigaPreventivo"
                          asp-route-id="@Model.Componente.IdRigaCompPrev">
                        <button type="submit" class="pfw-btn pfw-btn-danger">Conferma eliminazione</button>
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Workspace"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo">
                            Annulla
                        </a>
                    </form>
                }
                else
                {
                    <section class="pfw-panel mt-4">
                        <div class="workspace-tabs">
                            <a href="#materiali-componente" class="workspace-tab active text-decoration-none">
                                Materiali (@Model.Materiali.Count)
                            </a>
                            <a href="#lavorazioni-componente" class="workspace-tab text-decoration-none">
                                Lavorazioni (@Model.Lavorazioni.Count)
                            </a>
                            <a href="#allegati-componente" class="workspace-tab text-decoration-none">
                                Allegati (@Model.Allegati.Allegati.Count)
                            </a>
                        </div>

                        <div class="workspace-tab-content">
                            <div id="materiali-componente" class="preventivo-section-toolbar">
                                <div>
                                    <span class="preventivo-section-title">Materiali</span>
                                    <span class="preventivo-section-count">@Model.Materiali.Count righe</span>
                                </div>
                                <a class="pfw-btn pfw-btn-primary"
                                   asp-page="/Preventivi/Riga/Materiali"
                                   asp-route-modo="nuovo"
                                   asp-route-idPreventivo="@idPreventivo"
                                   asp-route-idRigaPreventivo="@idRigaPreventivo"
                                   asp-route-idComponente="@Model.Componente.IdRigaCompPrev">
                                    Nuovo materiale
                                </a>
                            </div>

                            @if (Model.Materiali.Count == 0)
                            {
                                <div class="workspace-placeholder">
                                    <div class="workspace-placeholder-title">Nessun materiale presente</div>
                                </div>
                            }
                            else
                            {
                                <div class="preventivi-table-wrap">
                                    <table class="table pfw-table preventivi-table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Descrizione</th>
                                                <th>Tipo</th>
                                                <th>UM</th>
                                                <th class="text-end">Quantità</th>
                                                <th class="text-end">Costo unitario</th>
                                                <th class="text-end">Costo totale</th>
                                                <th>Da acquistare</th>
                                                <th class="text-end">Azioni</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var materiale in Model.Materiali)
                                            {
                                                <tr>
                                                    <td>@materiale.DescrizioneMateriale</td>
                                                    <td>@materiale.TipoMateriale</td>
                                                    <td>@materiale.UM</td>
                                                    <td class="text-end">@materiale.Quantita.ToString("N2")</td>
                                                    <td class="text-end">@materiale.CostoUnitario.ToString("C4")</td>
                                                    <td class="text-end">@materiale.CostoTotale.ToString("C2")</td>
                                                    <td>
                                                        <input type="checkbox" checked="@materiale.DaAcquistare" disabled />
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="preventivi-actions">
                                                        <a class="pfw-btn pfw-btn-secondary pfw-btn-compact"
                                                           asp-page="/Preventivi/Riga/Materiali"
                                                           asp-route-modo="dettaglio"
                                                           asp-route-idPreventivo="@idPreventivo"
                                                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                                                           asp-route-idComponente="@Model.Componente.IdRigaCompPrev"
                                                           asp-route-id="@materiale.IdRigaMatPrev">
                                                            Apri
                                                        </a>
                                                        <a class="pfw-btn pfw-btn-danger pfw-btn-compact"
                                                           asp-page="/Preventivi/Riga/Materiali"
                                                           asp-route-modo="elimina"
                                                           asp-route-idPreventivo="@idPreventivo"
                                                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                                                           asp-route-idComponente="@Model.Componente.IdRigaCompPrev"
                                                           asp-route-id="@materiale.IdRigaMatPrev">
                                                            Elimina
                                                        </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <hr id="lavorazioni-componente" class="my-4" />

                            <div class="preventivo-section-toolbar">
                                <div>
                                    <span class="preventivo-section-title">Lavorazioni</span>
                                    <span class="preventivo-section-count">@Model.Lavorazioni.Count righe</span>
                                </div>
                                <a class="pfw-btn pfw-btn-primary"
                                   asp-page="/Preventivi/Riga/Lavorazioni"
                                   asp-route-modo="nuovo"
                                   asp-route-idPreventivo="@idPreventivo"
                                   asp-route-idRigaPreventivo="@idRigaPreventivo"
                                   asp-route-idComponente="@Model.Componente.IdRigaCompPrev">
                                    Nuova lavorazione
                                </a>
                            </div>

                            @if (Model.Lavorazioni.Count == 0)
                            {
                                <div class="workspace-placeholder">
                                    <div class="workspace-placeholder-title">Nessuna lavorazione presente</div>
                                </div>
                            }
                            else
                            {
                                <div class="preventivi-table-wrap">
                                    <table class="table pfw-table preventivi-table align-middle">
                                        <thead>
                                            <tr>
                                                <th class="text-end">Sequenza</th>
                                                <th>Descrizione</th>
                                                <th class="text-end">Tempo totale</th>
                                                <th class="text-end">Costo totale</th>
                                                <th>Esterno</th>
                                                <th class="text-end">Azioni</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var lavorazione in Model.Lavorazioni)
                                            {
                                                <tr>
                                                    <td class="text-end">@lavorazione.Sequenza</td>
                                                    <td>@lavorazione.DescrizioneLavorazione</td>
                                                    <td class="text-end">@lavorazione.TempoTotaleMin.ToString("N2")</td>
                                                    <td class="text-end">@lavorazione.CostoTotale.ToString("C2")</td>
                                                    <td>
                                                        <input type="checkbox" checked="@lavorazione.DaAcquistareEsterno" disabled />
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="preventivi-actions">
                                                        <a class="pfw-btn pfw-btn-secondary pfw-btn-compact"
                                                           asp-page="/Preventivi/Riga/Lavorazioni"
                                                           asp-route-modo="dettaglio"
                                                           asp-route-idPreventivo="@idPreventivo"
                                                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                                                           asp-route-idComponente="@Model.Componente.IdRigaCompPrev"
                                                           asp-route-id="@lavorazione.IdRigaLavPrev">
                                                            Apri
                                                        </a>
                                                        <a class="pfw-btn pfw-btn-danger pfw-btn-compact"
                                                           asp-page="/Preventivi/Riga/Lavorazioni"
                                                           asp-route-modo="elimina"
                                                           asp-route-idPreventivo="@idPreventivo"
                                                           asp-route-idRigaPreventivo="@idRigaPreventivo"
                                                           asp-route-idComponente="@Model.Componente.IdRigaCompPrev"
                                                           asp-route-id="@lavorazione.IdRigaLavPrev">
                                                            Elimina
                                                        </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <hr id="allegati-componente" class="my-4" />

                            @await Html.PartialAsync(
                                "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                                new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                                {
                                    TestoNuovo = "Nuovo allegato",
                                    UrlNuovo = $"/Allegati/Nuovo?Entita=PreventiviRigheComponenti&IdEntita={Model.Componente.IdRigaCompPrev}&ReturnUrl={Uri.EscapeDataString(returnUrl)}"
                                })

                            @if (Model.Allegati.Allegati.Count == 0)
                            {
                                <div class="workspace-placeholder">
                                    <div class="workspace-placeholder-title">Nessun allegato presente</div>
                                </div>
                            }
                            else
                            {
                                @await Html.PartialAsync(
                                    "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                                    Model.Allegati)
                            }
                        </div>
                    </section>

                    <div class="mt-3">
                        <a class="pfw-btn pfw-btn-secondary"
                           asp-page="/Preventivi/Riga/Workspace"
                           asp-route-idPreventivo="@idPreventivo"
                           asp-route-idRigaPreventivo="@idRigaPreventivo">
                            Torna alla riga
                        </a>
                    </div>
                }
            }
        </div>
    </section>
</div>
