@page "{id:int}"
@model global::Preventivi.Web.Pages.Amministrazione.Utenti.PasswordModel
@{ var u=Model.Utente!; ViewData["Title"]="Reimposta password"; }
<div class="workspace-header"><a asp-page="./Dettaglio" asp-route-id="@u.IdUtente">@u.Username</a><h1 class="workspace-title mt-2">Reimposta password</h1></div>
<section class="pfw-panel"><form method="post"><div class="pfw-panel-body"><input asp-for="Versione" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <p>Imposta una nuova password per <strong>@u.Username</strong>. Le sessioni aperte dell’utente saranno invalidate e servirà un nuovo accesso.</p>
    <div class="row g-3"><div class="col-12 col-md-6 pfw-field-required"><label asp-for="NuovaPassword" class="form-label">Nuova password *</label><input asp-for="NuovaPassword" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="256" required /></div><div class="col-12 col-md-6 pfw-field-required"><label asp-for="ConfermaPassword" class="form-label">Conferma password *</label><input asp-for="ConfermaPassword" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="256" required /></div></div>
    <p class="form-text mt-3">Da 12 a 256 caratteri. La password precedente non è consultabile.</p>
</div><div class="pfw-panel-footer d-flex gap-2 justify-content-end"><a asp-page="./Dettaglio" asp-route-id="@u.IdUtente" class="pfw-btn pfw-btn-secondary">Annulla</a><button class="pfw-btn pfw-btn-primary" type="submit">Conferma reset password</button></div></form></section>
