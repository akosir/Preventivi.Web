@page
@model global::Preventivi.Web.Pages.Campionature.AdeguamentoEliminaModel

@{
    var campionatura = Model.Campionatura!;
    var adeguamento = Model.Adeguamento!;
    ViewData["Title"] = $"Elimina adeguamento rilievo {adeguamento.RigaNrRilievo}";
}

<div class="workspace-page">
    <div class="workspace-header">
        <div class="workspace-breadcrumb">
            <a asp-page="./Index">Campionature</a>
            <span>/</span>
            <a asp-page="./Dettaglio" asp-route-id="@campionatura.IdCampionatura">@campionatura.NumeroCompleto</a>
            <span>/</span>
            <a asp-page="./AdeguamentoDettaglio"
               asp-route-idCampionatura="@campionatura.IdCampionatura"
               asp-route-id="@adeguamento.IdAdeguamento">Adeguamento</a>
            <span>/</span>
            <span>Elimina</span>
        </div>
        <h1 class="workspace-title">Elimina adeguamento</h1>
        <p class="page-subtitle">Campionatura @campionatura.NumeroCompleto - Rilievo @adeguamento.RigaNrRilievo</p>
    </div>

    <section class="pfw-panel">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Conferma eliminazione</h2>
                <div class="pfw-panel-subtitle">L'operazione elimina definitivamente l'adeguamento proposto</div>
            </div>
        </div>
        <div class="pfw-panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
            @if (adeguamento.Applicato)
            {
                <div class="alert alert-warning">Un adeguamento applicato costituisce storico e non puo essere eliminato.</div>
            }
            else if (adeguamento.IdVarianteGenerata.HasValue)
            {
                <div class="alert alert-warning">Annullare prima la preparazione della variante generata.</div>
            }
            else if (Model.HaAllegati)
            {
                <div class="alert alert-warning">Eliminare prima tutti gli allegati collegati all'adeguamento.</div>
            }
            <dl class="row mb-0">
                <dt class="col-sm-3">Rilievo</dt>
                <dd class="col-sm-9">@adeguamento.RigaNrRilievo</dd>
                <dt class="col-sm-3">Descrizione adeguamento</dt>
                <dd class="col-sm-9">@adeguamento.DescrizioneAdeguamento</dd>
                <dt class="col-sm-3">Stato</dt>
                <dd class="col-sm-9">@(adeguamento.Applicato ? "Applicato" : "Proposto")</dd>
            </dl>
            <form method="post" class="d-flex justify-content-end gap-2 mt-3">
                <input asp-for="VersioneRigaBase64" type="hidden" />
                <input asp-for="VersioneRilievoBase64" type="hidden" />
                <a asp-page="./AdeguamentoDettaglio"
                   asp-route-idCampionatura="@campionatura.IdCampionatura"
                   asp-route-id="@adeguamento.IdAdeguamento"
                   class="pfw-btn pfw-btn-secondary">Annulla</a>
                @if (!adeguamento.Applicato && !adeguamento.IdVarianteGenerata.HasValue && !Model.HaAllegati)
                {
                    <button type="submit" class="pfw-btn pfw-btn-danger">Elimina</button>
                }
            </form>
        </div>
    </section>
</div>
