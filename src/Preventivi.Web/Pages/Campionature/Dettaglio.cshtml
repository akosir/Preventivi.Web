@page
@model global::Preventivi.Web.Pages.Campionature.DettaglioModel
@using global::Preventivi.Core.Campionature
@using global::Preventivi.Web.UI.Button

@{
    var campionatura = Model.Campionatura!;
    ViewData["Title"] = $"Campionatura {campionatura.NumeroCompleto}";
}

<div class="workspace-page">
    <div class="workspace-header d-flex justify-content-between align-items-start gap-3">
        <div>
            <div class="workspace-breadcrumb">
                <a asp-page="./Index">Campionature</a>
                <span>/</span>
                <span>@campionatura.NumeroCompleto</span>
            </div>
            <h1 class="workspace-title">Campionatura @campionatura.NumeroCompleto</h1>
            <p class="page-subtitle">@campionatura.Oggetto</p>
        </div>
        <div class="d-flex gap-2 no-print">
            @await Html.PartialAsync(
                "Shared/PFW/Button/_PFWButton",
                new PFWButtonModel
                {
                    Testo = "Stampa",
                    Variante = "secondary",
                    OnClick = "window.print()"
                })
            @await Html.PartialAsync(
                "Shared/PFW/Button/_PFWButton",
                new PFWButtonModel
                {
                    Testo = "Nuova campionatura",
                    Variante = "secondary",
                    Url = Url.Page("/Campionature/Nuova", new { idRichiestaCliente = campionatura.IdRichiestaCliente })
                })
            @await Html.PartialAsync(
                "Shared/PFW/Button/_PFWButton",
                new PFWButtonModel
                {
                    Testo = "Modifica",
                    Variante = "secondary",
                    Url = Url.Page("/Campionature/Modifica", new { id = campionatura.IdCampionatura })
                })
            @await Html.PartialAsync(
                "Shared/PFW/Button/_PFWButton",
                new PFWButtonModel
                {
                    Testo = "Aggiorna stato",
                    Variante = "primary",
                    Url = Url.Page("/Campionature/Stato", new { id = campionatura.IdCampionatura })
                })
        </div>
    </div>

    @if (TempData["MessaggioSuccesso"] is string messaggio)
    {
        <div class="alert alert-success">@messaggio</div>
    }
    @if (TempData["MessaggioErrore"] is string errore)
    {
        <div class="alert alert-danger">@errore</div>
    }

    <section class="pfw-panel mb-3">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Dati campionatura</h2>
                <div class="pfw-panel-subtitle">Dati identificativi e operativi</div>
            </div>
        </div>
        <div class="pfw-panel-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Numero campionatura</dt>
                <dd class="col-sm-9">@campionatura.NumeroCompleto</dd>
                <dt class="col-sm-3">Data campionatura</dt>
                <dd class="col-sm-9">@campionatura.DataCampionatura.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">@campionatura.CodiceCliente - @campionatura.Cliente</dd>
                <dt class="col-sm-3">Richiesta cliente</dt>
                <dd class="col-sm-9">
                    <a asp-page="/RichiesteClienti/Dettaglio"
                       asp-route-id="@campionatura.IdRichiestaCliente"
                       class="pfw-action-link">@campionatura.NumeroRichiesta</a>
                </dd>
                <dt class="col-sm-3">Preventivo collegato</dt>
                <dd class="col-sm-9">
                    @if (campionatura.IdPreventivo.HasValue)
                    {
                        <a asp-page="/Preventivi/Dettaglio"
                           asp-route-id="@campionatura.IdPreventivo"
                           class="pfw-action-link">@campionatura.NumeroPreventivo</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>
                <dt class="col-sm-3">Variante collegata</dt>
                <dd class="col-sm-9">
                    @if (campionatura.IdVariantePreventivo.HasValue)
                    {
                        <a asp-page="/Preventivi/Varianti/Dettaglio"
                           asp-route-idPreventivo="@campionatura.IdPreventivo"
                           asp-route-idVariantePreventivo="@campionatura.IdVariantePreventivo"
                           class="pfw-action-link">@campionatura.VariantePreventivo</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>
                <dt class="col-sm-3">Oggetto</dt>
                <dd class="col-sm-9">@campionatura.Oggetto</dd>
                <dt class="col-sm-3">Descrizione campione</dt>
                <dd class="col-sm-9">@(campionatura.DescrizioneCampione ?? "-")</dd>
                <dt class="col-sm-3">Stato</dt>
                <dd class="col-sm-9">@campionatura.Stato</dd>
                <dt class="col-sm-3">Priorita</dt>
                <dd class="col-sm-9">@campionatura.Priorita</dd>
                <dt class="col-sm-3">Data richiesta campione</dt>
                <dd class="col-sm-9">@(campionatura.DataRichiestaCampione?.ToString("dd/MM/yyyy") ?? "-")</dd>
                <dt class="col-sm-3">Consegna prevista</dt>
                <dd class="col-sm-9">@(campionatura.DataPrevistaConsegna?.ToString("dd/MM/yyyy") ?? "-")</dd>
                <dt class="col-sm-3">Consegna effettiva</dt>
                <dd class="col-sm-9">@(campionatura.DataConsegnaCampione?.ToString("dd/MM/yyyy") ?? "-")</dd>
                <dt class="col-sm-3">Data chiusura</dt>
                <dd class="col-sm-9">@(campionatura.DataChiusura?.ToString("dd/MM/yyyy") ?? "-")</dd>
                <dt class="col-sm-3">Esito</dt>
                <dd class="col-sm-9">@(campionatura.Esito ?? "-")</dd>
                <dt class="col-sm-3">Note</dt>
                <dd class="col-sm-9">@(campionatura.Note ?? "-")</dd>
                <dt class="col-sm-3">Creato il</dt>
                <dd class="col-sm-9">@campionatura.DataCreazione.ToString("dd/MM/yyyy HH:mm") da @campionatura.UtenteCreazione</dd>
                <dt class="col-sm-3">Ultima modifica</dt>
                <dd class="col-sm-9">
                    @(campionatura.DataModifica.HasValue
                        ? $"{campionatura.DataModifica:dd/MM/yyyy HH:mm} da {campionatura.UtenteModifica ?? "utente non disponibile"}"
                        : "-")
                </dd>
            </dl>
        </div>
    </section>

    @if (Model.CorrezioniStato.Count > 0)
    {
        <section class="pfw-panel mb-3">
            <div class="pfw-panel-header">
                <div>
                    <h2 class="pfw-panel-title">Correzioni amministrative</h2>
                    <div class="pfw-panel-subtitle">Storico delle variazioni esterne al workflow ordinario</div>
                </div>
            </div>
            <div class="pfw-panel-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Stato precedente</th>
                                <th>Nuovo stato</th>
                                <th>Motivazione</th>
                                <th>Utente</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var correzione in Model.CorrezioniStato)
                            {
                                <tr>
                                    <td>@correzione.DataCorrezione.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@correzione.StatoPrecedente</td>
                                    <td>@correzione.StatoNuovo</td>
                                    <td>@correzione.Motivazione</td>
                                    <td>@correzione.UtenteCorrezione</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    <section class="pfw-panel mb-3">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Rilievi</h2>
                <div class="pfw-panel-subtitle">Problematiche rilevate durante la campionatura</div>
            </div>
            <a asp-page="./RilievoNuovo"
               asp-route-idCampionatura="@campionatura.IdCampionatura"
               class="pfw-btn pfw-btn-primary no-print">Nuovo rilievo</a>
        </div>
        <div class="pfw-panel-body p-0">
            @if (Model.Rilievi.Count == 0)
            {
                <p class="p-3 mb-0 text-muted">Nessun rilievo registrato.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th>Data</th>
                                <th>Tipo problematica</th>
                                <th>Descrizione</th>
                                <th>Gravita</th>
                                <th>Stato</th>
                                <th class="text-end no-print">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rilievo in Model.Rilievi)
                            {
                                <tr>
                                    <td>@rilievo.RigaNr</td>
                                    <td>@rilievo.DataRilevazione.ToString("dd/MM/yyyy")</td>
                                    <td>@rilievo.TipoProblematica</td>
                                    <td>@rilievo.DescrizioneProblema</td>
                                    <td>@rilievo.Gravita</td>
                                    <td>@rilievo.Stato</td>
                                    <td class="text-end no-print">
                                        <a asp-page="./RilievoDettaglio"
                                           asp-route-idCampionatura="@campionatura.IdCampionatura"
                                           asp-route-id="@rilievo.IdRilievoCampionatura"
                                           class="pfw-action-link">Apri</a>
                                        @if (!CampionaturaRilievoValori.StatoFinale(rilievo.Stato))
                                        {
                                            <span class="text-muted mx-1">|</span>
                                            <a asp-page="./RilievoModifica"
                                               asp-route-idCampionatura="@campionatura.IdCampionatura"
                                               asp-route-id="@rilievo.IdRilievoCampionatura"
                                               class="pfw-action-link">Modifica</a>
                                        }
                                        @if (rilievo.Stato == "Aperto" &&
                                             Model.Adeguamenti.All(a => a.IdRilievoCampionatura != rilievo.IdRilievoCampionatura))
                                        {
                                            <span class="text-muted mx-1">|</span>
                                            <a asp-page="./RilievoElimina"
                                               asp-route-idCampionatura="@campionatura.IdCampionatura"
                                               asp-route-id="@rilievo.IdRilievoCampionatura"
                                               class="pfw-action-link text-danger">Elimina</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="pfw-panel mb-3">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Adeguamenti preventivo</h2>
                <div class="pfw-panel-subtitle">Valutazioni economiche collegate ai rilievi</div>
            </div>
        </div>
        <div class="pfw-panel-body p-0">
            @if (Model.Adeguamenti.Count == 0)
            {
                <p class="p-3 mb-0 text-muted">Nessun adeguamento registrato.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Rilievo</th>
                                <th>Descrizione</th>
                                <th class="text-end">Impatto costi</th>
                                <th class="text-end">Impatto vendita</th>
                                <th>Stato</th>
                                <th class="text-end no-print">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var adeguamento in Model.Adeguamenti)
                            {
                                <tr>
                                    <td>
                                        <a asp-page="./RilievoDettaglio"
                                           asp-route-idCampionatura="@campionatura.IdCampionatura"
                                           asp-route-id="@adeguamento.IdRilievoCampionatura"
                                           class="pfw-action-link">@adeguamento.RigaNrRilievo</a>
                                    </td>
                                    <td>@adeguamento.DescrizioneAdeguamento</td>
                                    <td class="text-end">@adeguamento.ImpattoCostoStimato.ToString("N2")</td>
                                    <td class="text-end">@adeguamento.ImpattoVenditaStimato.ToString("N2")</td>
                                    <td>
                                        @(adeguamento.Applicato
                                            ? "Applicato"
                                            : adeguamento.IdVarianteGenerata.HasValue
                                                ? "Preparato"
                                                : "Proposto")
                                    </td>
                                    <td class="text-end no-print">
                                        <a asp-page="./AdeguamentoDettaglio"
                                           asp-route-idCampionatura="@campionatura.IdCampionatura"
                                           asp-route-id="@adeguamento.IdAdeguamento"
                                           class="pfw-action-link">Apri</a>
                                        @if (!adeguamento.Applicato)
                                        {
                                            <span class="text-muted mx-1">|</span>
                                            <a asp-page="./AdeguamentoModifica"
                                               asp-route-idCampionatura="@campionatura.IdCampionatura"
                                               asp-route-id="@adeguamento.IdAdeguamento"
                                               class="pfw-action-link">Modifica</a>
                                            <span class="text-muted mx-1">|</span>
                                            <a asp-page="./AdeguamentoElimina"
                                               asp-route-idCampionatura="@campionatura.IdCampionatura"
                                               asp-route-id="@adeguamento.IdAdeguamento"
                                               class="pfw-action-link text-danger">Elimina</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="pfw-panel">
        <div class="pfw-panel-header">
            <div>
                <h2 class="pfw-panel-title">Allegati</h2>
                <div class="pfw-panel-subtitle">Documenti associati alla campionatura</div>
            </div>
        </div>
        <div class="pfw-panel-body">
            <div class="no-print">
                @await Html.PartialAsync(
                    "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
                    new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
                    {
                        TestoNuovo = "Nuovo allegato",
                        UrlNuovo = $"/Allegati/Nuovo?Entita=Campionature&IdEntita={campionatura.IdCampionatura}&ReturnUrl={Uri.EscapeDataString(Url.Page("/Campionature/Dettaglio", new { id = campionatura.IdCampionatura })!)}",
                        MostraNuovo = true,
                        MostraAggiorna = false
                    })
            </div>
            @await Html.PartialAsync(
                "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
                Model.Allegati)
        </div>
    </section>
</div>
