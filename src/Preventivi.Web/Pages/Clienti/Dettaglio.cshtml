@page
@model global::Preventivi.Web.Pages.Clienti.DettaglioModel

@{
    ViewData["Title"] = "Dettaglio Cliente";
}

@await Html.PartialAsync(
    "Shared/Clienti/_ClientiHeader",
    Model.Header)

<form method="post">

    <input type="hidden"
           asp-for="IdCliente" />

    @await Html.PartialAsync(
        "Shared/Clienti/_ClienteForm",
        Model.Cliente)

    <hr class="my-4" />

    @await Html.PartialAsync(
        "~/Pages/Shared/Allegati/_AllegatiHeader.cshtml",
        new global::Preventivi.Web.UI.Modules.Allegati.AllegatiHeaderModel
        {
            Titolo = "Allegati",
            Sottotitolo = "Documenti associati al cliente"
        })

    @await Html.PartialAsync(
        "~/Pages/Shared/Allegati/_AllegatiToolbar.cshtml",
        new global::Preventivi.Web.UI.Modules.Allegati.AllegatiToolbarModel
{
    TestoNuovo = "Nuovo Allegato",

    UrlNuovo =
        $"/Allegati/Nuovo?Entita=Clienti&IdEntita={Model.IdCliente}",

    MostraNuovo = true,

    MostraAggiorna = false
})

    @await Html.PartialAsync(
        "~/Pages/Shared/Allegati/_AllegatiGrid.cshtml",
        Model.Allegati)

    <div class="d-flex justify-content-end gap-2 mt-3">

        <a asp-page="./Index"
           class="pfw-btn pfw-btn-secondary">
            Annulla
        </a>

        <button type="submit"
                class="pfw-btn pfw-btn-primary">
            Salva modifiche
        </button>

    </div>

</form>