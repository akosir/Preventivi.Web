@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <div class="dashboard-heading">
        <div>
            <h1 class="dashboard-title">Dashboard</h1>
            <p class="dashboard-subtitle">
                Collegamenti ai moduli disponibili
            </p>
        </div>

        <div class="dashboard-date">
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
    </div>

    <div class="row g-3">

        <div class="col-12 col-md-6 col-xl-4">
            <section class="pfw-panel h-100">

                <div class="pfw-panel-header">
                    <div>
                        <h2 class="pfw-panel-title">Preventivi</h2>
                        <div class="pfw-panel-subtitle">
                            Elenco e dettaglio dei preventivi
                        </div>
                    </div>
                </div>

                <div class="pfw-panel-body">
                    <a asp-page="/Preventivi/Index"
                       class="pfw-btn pfw-btn-primary">
                        Apri Preventivi
                    </a>
                </div>

            </section>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <section class="pfw-panel h-100">

                <div class="pfw-panel-header">
                    <div>
                        <h2 class="pfw-panel-title">Clienti</h2>
                        <div class="pfw-panel-subtitle">
                            Anagrafica clienti e allegati cliente
                        </div>
                    </div>
                </div>

                <div class="pfw-panel-body d-flex flex-wrap gap-2">
                    <a asp-page="/Clienti/Index"
                       class="pfw-btn pfw-btn-primary">
                        Apri Clienti
                    </a>

                    <a asp-page="/Clienti/Nuovo"
                       class="pfw-btn pfw-btn-secondary">
                        Nuovo Cliente
                    </a>
                </div>

            </section>
        </div>

    </div>

</div>
